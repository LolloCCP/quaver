import { ListView } from "std-widgets.slint";
import { Theme, Custom, Scene, Playing, Backdrop, Glass, KeyFocus, Icon, Pill, PlayButton, Bar, Cover, Link, Transport, Timeline, SearchBox } from "glass.slint";
import { Card, Shelf, HomeView, LibraryItem } from "home.slint";
import { ThemeCard, Version, TrackRow, Row, NowPlaying, SettingsView } from "views.slint";

export { Theme, Custom, Scene, Playing, ThemeCard, Version, TrackRow, Card, Shelf }

export component App inherits Window {
    title: root.track-title == "" ? "Rustbeat" : root.track-title + " · " + root.track-artist;
    icon: @image-url("icon.svg");
    // Rustbeat draws its own window buttons and drag area (below), in place of the Windows title bar.
    no-frame: true;
    in property <bool> is-maximized;
    // False while karaoke hides everything but the cover and the lyrics.
    in-out property <bool> chrome-shown: true;
    // The pointer's own cursor setting only takes effect on the next movement, so the window hides it.
    property <bool> cursor-hidden: !root.chrome-shown && root.now-playing;
    changed cursor-hidden => { root.cursor-hidden-changed(root.cursor-hidden); }
    callback cursor-hidden-changed(bool);
    callback window-drag();
    callback window-resize(int);
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    property <duration> last-press;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.glass;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in property <bool> ready;
    in property <bool> need-login;
    in property <bool> busy;
    in property <string> message;
    in property <string> status;
    in property <[Card]> playlists;
    in property <[Card]> tiles;
    in property <[Shelf]> shelves;
    in property <string> greeting: "Welcome";
    in-out property <string> home-note;
    in-out property <bool> home-open: true;
    in-out property <bool> panel-open: true;
    in property <image> panel-cover;
    // The list being opened, before its songs are here, and its picture.
    in-out property <string> opening;
    in-out property <string> list-picture-id;
    in property <image> list-picture;
    in-out property <bool> list-has-picture;
    in property <[TrackRow]> rows;
    in property <string> list-title;
    in property <string> list-context;
    in property <bool> loading;
    in property <bool> has-more;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-artist-uri;
    in property <string> track-album;
    in property <bool> has-cover;
    in property <image> cover;
    in property <image> thumb;
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    in property <float> volume;
    in property <bool> shuffle;
    in property <int> repeat;
    in-out property <bool> now-playing;
    in-out property <bool> lyrics-open: true;
    in property <[string]> lyrics;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-note;
    in-out property <bool> karaoke;
    // Liked songs and playlists.
    in property <bool> track-liked;
    callback like(string, bool);
    callback like-playing();
    // Opens the playlist chooser for a song; empty makes a playlist without one.
    callback choose-playlist(string);
    callback add-playing();
    in-out property <bool> picker-open;
    in-out property <string> picker-track;
    in property <[Card]> picker-lists;
    callback new-playlist(string, string);
    callback add-to-playlist(string, string, string);
    // Karaoke's cover, drawn in Rust in the chosen style.
    in property <image> stage-art;
    in property <image> stage-extra;
    in property <image> stage-haze;
    in property <int> stage-style;
    callback set-stage(int);
    callback stage-resized(length);
    // Whether karaoke's record may have to turn.
    callback stage-changed();
    changed karaoke => { root.stage-changed(); }
    out property <bool> lyrics-visible: root.ready && (root.now-playing ? root.lyrics-open || root.karaoke : root.panel-shown);
    in-out property <bool> settings-open;
    property <bool> list-shown: !root.home-open && !root.settings-open;
    property <bool> panel-shown: root.panel-open && root.width >= 1160px && root.track-title != "";
    property <length> library-width: max(220px, min(300px, root.width * 0.22));
    in property <bool> eq-on;
    in property <[float]> eq;
    in property <[string]> presets;
    in property <int> bitrate;
    in property <bool> normalise;
    in property <bool> tray;
    in property <bool> updates;
    in property <bool> gpu;
    in property <bool> needs-restart;
    in property <bool> soloist;
    in property <string> player-note;
    callback set-soloist(bool);
    callback soloist-key(string);
    callback soloist-folder();
    callback soloist-download();
    callback soloist-get-key();
    callback soloist-about();
    in property <bool> offline;
    in property <string> music;
    callback set-offline(bool);
    callback choose-music();
    callback discord();
    // Who is in the current Jam; nobody when there is none.
    in property <[string]> jam;
    in property <string> jam-link;
    in-out property <bool> jam-open;
    callback copy-jam-link();
    in property <bool> soloist-here;
    in property <bool> soloist-has-key;
    in property <bool> soloist-paired;
    in property <bool> downloading;
    callback open-spotify();
    // Empty for what was built from source.
    in property <string> version;
    in property <[Version]> versions;
    in property <bool> version-chosen;
    in property <bool> updating;
    in property <bool> update-ready;
    in property <string> update-note;
    callback use-version(string);
    callback restart();
    // Whose page takes the place of home; the title is empty for none, the URI for one's own.
    in-out property <string> people-title;
    in-out property <string> people-uri;
    // An artist's biography, shown under their name.
    in property <string> people-about;
    in property <int> follow;
    callback people(string);
    callback set-follow(string, bool);
    in property <[ThemeCard]> themes;
    in property <string> theme;
    in property <bool> glass-theme: true;
    callback set-theme-id(string);
    callback settings-shown();
    changed settings-open => { if (root.settings-open) { root.settings-shown(); } }
    in-out property <string> toast;
    in-out property <bool> blocked;
    in property <bool> gliding;
    // Which row the pointer is on; none while the list moves under it.
    property <int> hovered-row: Scene.hovering && !root.gliding && root.over-list() ? floor((Scene.mouse-y - area.absolute-position.y - list.content-y) / 60px) : -1;
    public function show-toast() { toast-timer.restart(); }
    toast-timer := Timer { interval: 6s; running: root.toast != ""; triggered => { root.toast = ""; } }

    callback connect();
    callback logout();
    callback liked();
    callback queue();
    callback clear-queue();
    callback open(string, string);
    callback search(string);
    callback typed(string);
    callback stop-glide();
    callback more();
    callback play(string);
    callback enqueue(string);
    callback need-picture(int, string);
    callback play-list(string);
    callback load-home();
    callback retry-home();
    callback toggle();
    callback next();
    callback prev();
    callback seek(float);
    callback seek-line(int);
    callback lyrics-wanted();
    callback set-volume(float);
    callback set-shuffle(bool);
    callback set-repeat(int);
    callback tick();
    callback toggle-fullscreen();
    callback leave-fullscreen();
    callback art-resized(length);
    callback set-eq-on(bool);
    callback set-band(int, float);
    callback set-preset(int);
    callback set-bitrate(int);
    callback set-normalise(bool);
    callback set-tray(bool);
    callback set-updates(bool);
    callback set-tint(float);
    callback set-motion(bool);
    callback set-gpu(bool);
    callback glide(float);
    in property <float> bounce;

    property <length> home-rest: max(0px, home.content-height - home.visible-height);
    property <length> rest: max(0px, list.content-height - list.visible-height);
    // Long lists get a tall header that folds away while scrolling.
    // Folding gives the list 54px, so it has to overflow by clearly more than that. 356px is
    // everything above and below the list while the header is tall.
    property <bool> foldable: root.rows.length * 60px - (root.height - 356px) > 150px;
    property <bool> folded;
    property <length> scrolled: -list.content-y;
    property <bool> tall: !root.settings-open && !root.folded;
    changed scrolled => {
        if (root.folded) {
            if (root.scrolled < 8px) { root.folded = false; }
        } else if (root.foldable && root.scrolled > 30px) {
            root.folded = true;
        }
    }

    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    callback go-back();
    callback go-forward();
    public function go-home() {
        root.settings-open = false;
        root.home-open = true;
        root.load-home();
    }
    function open-artist() {
        root.now-playing = false;
        root.show-list(root.track-artist-uri, "");
        root.open(root.track-artist, root.track-artist-uri);
    }
    public function show-list(uri: string, picture: string) {
        root.settings-open = false;
        root.home-open = false;
        root.opening = uri;
        root.list-has-picture = false;
        root.list-picture-id = picture;
        if (picture != "") { root.need-picture(3, picture); }
    }
    function open-card(card: Card) {
        if (card.kind == 2 && card.subtitle == "Profile") {
            root.people(card.uri);
            return;
        }
        root.show-list(card.uri, card.picture-id);
        if (card.uri == "liked" || card.title == "Liked Songs") { root.liked(); } else { root.open(card.title, card.uri); }
    }
    public function reset-scroll() { list.content-y = 0; }
    public pure function over-list() -> bool {
        return root.ready && !root.now-playing && !root.settings-open && Scene.mouse-x >= area.absolute-position.x && Scene.mouse-x < area.absolute-position.x + area.width && Scene.mouse-y >= area.absolute-position.y && Scene.mouse-y < area.absolute-position.y + area.height;
    }
    // True when an end of the list stopped the movement.
    public function scroll-by(distance: float) -> bool {
        if (root.home-open) {
            home.content-y = max(-root.home-rest, min(0px, home.content-y + distance * 1px));
            return (distance > 0 && home.content-y >= 0px) || (distance < 0 && home.content-y <= -root.home-rest);
        }
        list.content-y = max(-root.rest, min(0px, list.content-y + distance * 1px));
        root.load-ahead();
        return (distance > 0 && list.content-y >= 0px) || (distance < 0 && list.content-y <= -root.rest);
    }
    function load-ahead() {
        if (root.has-more && !root.loading && -list.content-y > list.content-height - list.visible-height * 2) { root.more(); }
    }

    // Anything that changes what has to be painted behind the content.
    callback repaint();
    changed width => { root.repaint(); }
    changed height => { root.repaint(); }
    changed ready => { root.repaint(); }
    changed now-playing => { root.repaint(); root.stage-changed(); }
    changed panel-shown => {
        if (!root.panel-shown) { Scene.placed(4, 0, 0, 0, 0); }
    }
    changed lyrics-visible => { root.lyrics-wanted(); }

    Timer { interval: root.lyrics-visible && root.lyrics-synced ? 150ms : 500ms; running: root.playing && root.visible; triggered => { root.tick(); } }

    Backdrop { width: 100%; height: 100%; }

    forward-focus: keys;
    keys := FocusScope {
        // Anchored, so that the window is never sized from its content.
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        key-pressed(e) => {
            if (e.text == Key.F11) { root.toggle-fullscreen(); return accept; }
            if (e.text == Key.Escape) {
                // The playlist chooser is on top of everything, so it closes first.
                if (root.picker-open) { root.picker-open = false; return accept; }
                root.now-playing = false;
                root.settings-open = false;
                root.leave-fullscreen();
                return accept;
            }
            if (!root.ready) { return reject; }
            if (e.modifiers.alt && e.text == Key.LeftArrow) { root.go-back(); return accept; }
            if (e.modifiers.alt && e.text == Key.RightArrow) { root.go-forward(); return accept; }
            if (e.text == " ") { root.toggle(); return accept; }
            if (e.modifiers.control && e.text == Key.RightArrow) { root.next(); return accept; }
            if (e.modifiers.control && e.text == Key.LeftArrow) { root.prev(); return accept; }
            if (e.modifiers.control && e.text == "f") { root.now-playing = false; search.take-focus(); return accept; }
            if (e.modifiers.control && e.text == "h") { root.now-playing = false; root.go-home(); return accept; }
            if (e.modifiers.control && e.text == ",") { root.now-playing = false; root.settings-open = true; return accept; }
            return reject;
        }

        // The top strip moves the window; two presses in a row maximize it, as the title bar did.
        TouchArea {
            height: 58px;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    if (animation-tick() - root.last-press < 400ms) { root.window-maximize(); } else { root.window-drag(); }
                    root.last-press = animation-tick();
                }
            }
        }

        if !root.ready: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Glass {
                    width: min(560px, root.width - 64px);
                    VerticalLayout {
                        padding: 44px;
                        spacing: 20px;
                        HorizontalLayout { alignment: center; Image { source: @image-url("icon.svg"); width: 84px; height: 84px; } }
                        Text { text: "Rustbeat"; font-size: 38px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                        Text { text: root.message; wrap: word-wrap; color: Theme.dim; font-size: 15px; horizontal-alignment: center; }
                        if !root.busy: HorizontalLayout {
                            alignment: center;
                            Pill { text: root.need-login ? "Sign in with Spotify" : "Try again now"; clicked => { root.connect(); } }
                        }
                        if !root.busy: HorizontalLayout {
                            alignment: center;
                            Pill { quiet: true; text: "Play my own files"; clicked => { root.set-offline(true); } }
                        }
                    }
                }
            }
        }

        if root.ready && root.now-playing: NowPlaying {
            width: 100%;
            height: 100%;
            title: root.track-title;
            artist: root.track-artist;
            artist-uri: root.track-artist-uri;
            open-artist => { root.open-artist(); }
            album: root.track-album;
            cover: root.cover;
            has-cover: root.has-cover;
            playing: root.playing;
            shuffle: root.shuffle;
            repeat: root.repeat;
            progress: root.progress;
            elapsed: root.elapsed;
            total: root.total;
            lyrics-open: root.lyrics-open;
            lyrics: root.lyrics;
            lyrics-active: root.lyrics-active;
            lyrics-synced: root.lyrics-synced;
            lyrics-note: root.lyrics-note;
            karaoke: root.karaoke;
            track-liked: root.track-liked;
            can-save: !root.offline;
            like-playing => { root.like-playing(); }
            add-playing => { root.add-playing(); }
            volume: root.volume;
            set-volume(v) => { root.set-volume(v); }
            stage-art: root.stage-art;
            stage-extra: root.stage-extra;
            stage-haze: root.stage-haze;
            stage-style: root.stage-style;
            set-stage(i) => { root.set-stage(i); }
            stage-resized(size) => { root.stage-resized(size); }
            toggle-karaoke => { root.karaoke = !root.karaoke; }
            toggle => { root.toggle(); }
            next => { root.next(); }
            prev => { root.prev(); }
            set-shuffle(on) => { root.set-shuffle(on); }
            set-repeat(m) => { root.set-repeat(m); }
            seek(v) => { root.seek(v); }
            seek-line(i) => { root.seek-line(i); }
            toggle-lyrics => { root.lyrics-open = !root.lyrics-open; }
            close => { root.now-playing = false; root.leave-fullscreen(); }
            fullscreen => { root.toggle-fullscreen(); }
            window-drag => { root.window-drag(); }
            window-maximize => { root.window-maximize(); }
            controls-changed(on) => { root.chrome-shown = on; }
            art-resized(size) => { root.art-resized(size); }
        }

        VerticalLayout {
            visible: root.ready && !root.now-playing;
            padding: 12px;
            spacing: 12px;
            HorizontalLayout {
                height: 46px;
                spacing: 12px;
                // Room for the window buttons.
                padding-right: 112px;
                HorizontalLayout {
                    width: root.library-width;
                    padding-left: 8px;
                    spacing: 10px;
                    VerticalLayout { alignment: center; Image { source: @image-url("icon.svg"); width: 28px; height: 28px; } }
                    Text { text: "Rustbeat"; color: Theme.text; font-size: 17px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Icon { glyph: "\u{e72b}"; label: "Back"; enabled: root.can-go-back || root.settings-open; clicked => { root.go-back(); } } }
                    VerticalLayout { alignment: center; Icon { glyph: "\u{e72a}"; label: "Forward"; enabled: root.can-go-forward; clicked => { root.go-forward(); } } }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Icon { glyph: "\u{e80f}"; label: "Home"; on: root.home-open && !root.settings-open && root.people-title == ""; size: 18px; clicked => { root.go-home(); } } }
                if !root.offline: VerticalLayout { alignment: center; Icon { glyph: "\u{e716}"; label: "Friends"; on: root.home-open && !root.settings-open && root.people-title != "" && !root.people-uri.starts-with("spotify:artist:"); size: 18px; clicked => { root.people(""); } } }
                VerticalLayout {
                    width: min(480px, root.width * 0.42);
                    alignment: center;
                    search := SearchBox { edited(q) => { root.typed(q); } accepted(q) => { root.settings-open = false; root.search(q); } }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    width: 88px;
                    spacing: 6px;
                    alignment: end;
                    VerticalLayout { alignment: center; Icon { glyph: "\u{e713}"; label: "Settings"; on: root.settings-open; size: 18px; clicked => { root.settings-open = !root.settings-open; } } }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Glass {
                    panel: 1;
                    width: root.library-width;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            height: 34px;
                            spacing: 10px;
                            Text { text: "\u{e8f1}"; font-family: Theme.icons; color: Theme.dim; vertical-alignment: center; }
                            Text { text: "Your library"; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            if !root.offline: VerticalLayout { alignment: center; Icon { glyph: "\u{e710}"; label: "New playlist"; size: 13px; clicked => { root.choose-playlist(""); } } }
                        }
                        LibraryItem {
                            card: { title: root.offline ? "My files" : "Liked Songs", subtitle: root.offline ? "Every song" : "Your favorites", uri: "liked", picture-id: "", kind: 0 };
                            selected: root.list-shown && root.list-title == (root.offline ? "My files" : "Liked Songs");
                            clicked => { root.show-list("liked", ""); root.liked(); }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for p in root.playlists: LibraryItem {
                                card: p;
                                selected: root.list-shown && root.list-context == p.uri;
                                clicked => { root.open-card(p); }
                                need-picture(kind, id) => { root.need-picture(kind, id); }
                            }
                        }
                    }
                }
                Glass {
                    panel: 2;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        if !root.home-open || root.settings-open: HorizontalLayout {
                            height: root.tall ? 104px : 50px;
                            animate height { duration: Theme.quick * 1.5; easing: ease-in-out; }
                            spacing: 16px;
                            padding-left: 8px;
                            if root.tall && !root.settings-open && root.list-has-picture: VerticalLayout { alignment: center; Image { source: root.list-picture; width: 88px; height: 88px; } }
                            Text { text: root.settings-open ? "Settings" : root.list-title; font-size: root.tall ? 42px : 28px; font-weight: 700; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; animate font-size { duration: Theme.quick * 1.5; easing: ease-in-out; } }
                            if !root.settings-open && root.list-title == "Up next": VerticalLayout { alignment: center; Pill { quiet: true; text: "Clear queue"; clicked => { root.clear-queue(); } } }
                            // Aims past the top: the list shifts a little while rows come and go on the way.
                            if !root.settings-open && root.scrolled > 900px: VerticalLayout { alignment: center; Icon { glyph: "\u{e74a}"; label: "Back to top"; clicked => { if (Theme.motion) { root.glide(root.scrolled / 1px * 1.2 + 100); } else { root.reset-scroll(); } } } }
                            if !root.settings-open && root.rows.length > 0: VerticalLayout { alignment: center; PlayButton { size: 50px; clicked => { root.play(root.rows[0].uri); } } }
                        }
                        area := Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            home := HomeView {
                                visible: root.home-open && !root.settings-open;
                                y: self.visible ? root.bounce * 1px : 0px;
                                width: 100%;
                                height: 100%;
                                animate y { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                                greeting: root.people-title != "" ? root.people-title : root.greeting;
                                hint: root.people-title == "" ? "" : root.people-uri == "" ? "To find someone, paste the link to their profile into the search box." : root.people-about;
                                follow: root.people-title != "" ? root.follow : 0;
                                set-follow(on) => { root.set-follow(root.people-uri, on); }
                                note: root.home-note;
                                tiles: root.people-title != "" ? [] : root.tiles;
                                shelves: root.shelves;
                                open(c) => { root.open-card(c); }
                                play(uri) => { root.play-list(uri); }
                                need-picture(kind, id) => { root.need-picture(kind, id); }
                                retry => { root.home-note = ""; if (root.people-title != "") { root.people(root.people-uri); } else { root.retry-home(); } }
                            }
                            list := ListView {
                                visible: root.list-shown;
                                y: root.bounce * 1px;
                                width: 100%;
                                height: 100%;
                                animate y { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                                scrolled => { root.load-ahead(); }
                                for r[i] in root.rows: Row {
                                    item: r;
                                    lit: i == root.hovered-row;
                                    current: r.title == root.track-title && r.artist == root.track-artist;
                                    play => { root.play(r.uri); }
                                    enqueue => { root.enqueue(r.uri); }
                                    can-save: !root.offline;
                                    like(on) => { root.like(r.uri, on); }
                                    add-to => { root.choose-playlist(r.uri); }
                                    open(name, uri) => { root.show-list(uri, ""); root.open(name, uri); }
                                    need-cover(id) => { root.need-picture(0, id); }
                                }
                            }
                            if root.list-shown && root.rows.length == 0: Text {
                                text: root.loading ? "Loading…" : root.status;
                                color: Theme.dim;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.settings-open: SettingsView {
                                width: 100%;
                                height: 100%;
                                eq-on: root.eq-on;
                                eq: root.eq;
                                presets: root.presets;
                                bitrate: root.bitrate;
                                normalise: root.normalise;
                                tray: root.tray;
                                updates: root.updates;
                                gpu: root.gpu;
                                needs-restart: root.needs-restart;
                                soloist: root.soloist;
                                player-note: root.player-note;
                                set-soloist(v) => { root.set-soloist(v); }
                                soloist-key(k) => { root.soloist-key(k); }
                                soloist-folder => { root.soloist-folder(); }
                                soloist-download => { root.soloist-download(); }
                                soloist-get-key => { root.soloist-get-key(); }
                                offline: root.offline;
                                music: root.music;
                                set-offline(v) => { root.set-offline(v); }
                                choose-music => { root.choose-music(); }
                                soloist-about => { root.soloist-about(); }
                                soloist-here: root.soloist-here;
                                soloist-has-key: root.soloist-has-key;
                                soloist-paired: root.soloist-paired;
                                open-spotify => { root.open-spotify(); }
                                version: root.version;
                                versions: root.versions;
                                version-chosen: root.version-chosen;
                                updating: root.updating;
                                update-ready: root.update-ready;
                                update-note: root.update-note;
                                use-version(v) => { root.use-version(v); }
                                restart => { root.restart(); }
                                downloading: root.downloading;
                                themes: root.themes;
                                theme: root.theme;
                                glass-theme: root.glass-theme;
                                set-theme-id(id) => { root.set-theme-id(id); }
                                discord => { root.discord(); }
                                set-eq-on(v) => { root.set-eq-on(v); }
                                set-band(i, v) => { root.set-band(i, v); }
                                set-preset(i) => { root.set-preset(i); }
                                set-bitrate(v) => { root.set-bitrate(v); }
                                set-normalise(v) => { root.set-normalise(v); }
                                set-tray(v) => { root.set-tray(v); }
                                set-updates(v) => { root.set-updates(v); }
                                set-tint(v) => { root.set-tint(v); }
                                set-motion(v) => { root.set-motion(v); }
                                set-gpu(v) => { root.set-gpu(v); }
                                logout => { root.settings-open = false; root.logout(); }
                            }
                        }
                        if root.list-shown && root.rows.length > 0 && root.loading: Text { text: "Loading…"; color: Theme.dim; overflow: elide; }
                    }
                }
                if root.panel-shown: Glass {
                    panel: 4;
                    width: 288px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;
                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Now playing"; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            Icon { glyph: "\u{e711}"; label: "Close the now playing panel"; size: 12px; clicked => { root.panel-open = false; } }
                        }
                        panel-touch := TouchArea {
                            height: 256px;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Open now playing";
                            accessible-action-default => { root.now-playing = true; }
                            clicked => { root.now-playing = true; }
                            Rectangle { border-radius: 20px; background: Theme.raised; visible: !root.has-cover; }
                            if root.has-cover: Image { width: 256px; height: 256px; source: root.panel-cover; }
                            Rectangle { visible: panel-touch.has-hover || panel-focus.has-focus; border-radius: 20px; border-width: 2px; border-color: Theme.accent; }
                            panel-focus := KeyFocus { activated => { root.now-playing = true; } }
                        }
                        Text { text: root.track-title; color: Theme.text; font-size: 20px; font-weight: 700; wrap: word-wrap; }
                        Link { text: root.track-artist; wrap: word-wrap; linked: root.track-artist-uri != ""; color: Theme.accent; hover: Theme.text; clicked => { root.open-artist(); } }
                        Text { text: root.track-album; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
                        if root.lyrics-synced && root.lyrics.length > 0: VerticalLayout {
                            padding-top: 10px;
                            spacing: 8px;
                            Text { text: "Lyrics"; color: Theme.dim; font-size: 12px; }
                            Text { text: root.lyrics-active >= 0 ? root.lyrics[root.lyrics-active] : "♪"; color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                            Text { text: root.lyrics-active + 1 < root.lyrics.length ? root.lyrics[root.lyrics-active + 1] : ""; color: Theme.dim; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                        }
                    }
                }
            }
            Glass {
                panel: 3;
                height: 92px;
                HorizontalLayout {
                    padding: 13px;
                    spacing: 16px;
                    HorizontalLayout {
                        width: max(240px, root.width * 0.24);
                        spacing: 14px;
                        open-cover := TouchArea {
                            width: 66px;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Open now playing";
                            accessible-action-default => { root.now-playing = true; }
                            clicked => { root.now-playing = true; }
                            Cover { source: root.thumb; loaded: root.has-cover; }
                            Rectangle {
                                visible: open-cover.has-hover || cover-focus.has-focus;
                                border-radius: 12px;
                                background: #00000099;
                                Text { text: "\u{e740}"; font-family: Theme.icons; font-size: 18px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            cover-focus := KeyFocus { activated => { root.now-playing = true; } }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            alignment: center;
                            spacing: 2px;
                            Text { text: root.track-title; color: Theme.text; font-weight: 600; overflow: elide; }
                            Link { text: root.track-artist; linked: root.track-artist-uri != ""; font-size: 12px; clicked => { root.open-artist(); } }
                        }
                        if !root.offline && root.track-title != "": VerticalLayout {
                            alignment: center;
                            Icon { glyph: root.track-liked ? "\u{eb52}" : "\u{eb51}"; on: root.track-liked; size: 14px; label: root.track-liked ? "Remove from Liked Songs" : "Add to Liked Songs"; clicked => { root.like-playing(); } }
                        }
                        if !root.offline && root.track-title != "": VerticalLayout {
                            alignment: center;
                            Icon { glyph: "\u{ecc8}"; size: 14px; label: "Add to playlist"; clicked => { root.add-playing(); } }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Transport {
                            size: 42px;
                            playing: root.playing;
                            shuffle: root.shuffle;
                            repeat: root.repeat;
                            toggle => { root.toggle(); }
                            next => { root.next(); }
                            prev => { root.prev(); }
                            set-shuffle(on) => { root.set-shuffle(on); }
                            set-repeat(m) => { root.set-repeat(m); }
                        }
                        Timeline { progress: root.progress; elapsed: root.elapsed; total: root.total; seek(v) => { root.seek(v); } }
                    }
                    HorizontalLayout {
                        width: max(240px, root.width * 0.24);
                        spacing: 4px;
                        alignment: end;
                        if root.soloist: VerticalLayout { alignment: center; Icon { glyph: "\u{e716}"; label: root.jam.length > 0 ? "Jam, " + root.jam.length + " listening" : "Jam"; on: root.jam.length > 0; clicked => { root.jam-open = !root.jam-open; } } }
                        VerticalLayout { alignment: center; Icon { glyph: "\u{e8bd}"; label: "Open lyrics"; clicked => { root.lyrics-open = true; root.now-playing = true; } } }
                        VerticalLayout { alignment: center; Icon { glyph: "\u{e8fd}"; label: "Up next"; on: root.list-shown && root.list-title == "Up next"; clicked => { root.show-list("", ""); root.queue(); } } }
                        if root.width >= 1160px: VerticalLayout { alignment: center; Icon { glyph: "\u{e90d}"; label: root.panel-open ? "Close the now playing panel" : "Open the now playing panel"; on: root.panel-shown; clicked => { root.panel-open = !root.panel-open; } } }
                        Text { width: 26px; text: root.volume <= 0 ? "\u{e74f}" : "\u{e767}"; font-family: Theme.icons; color: Theme.dim; vertical-alignment: center; horizontal-alignment: right; }
                        VerticalLayout {
                            width: 104px;
                            alignment: center;
                            Bar { value: root.volume; label: "Volume"; live: true; commit(v) => { root.set-volume(v); } }
                        }
                    }
                }
            }
        }

        // Adds a song to one of one's playlists, or makes a new one.
        if root.picker-open && root.ready: Rectangle {
            width: root.width;
            height: root.height;
            background: #00000066;
            TouchArea { clicked => { root.picker-open = false; } }
            FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.picker-open = false; return accept; }
                    return reject;
                }
            }
            Rectangle {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: min(440px, root.width - 40px);
                // As tall as its playlists need, up to most of the window.
                height: root.picker-track == "" ? picker-box.preferred-height : min(560px, root.height - 80px, 150px + max(1, root.picker-lists.length) * 60px);
                border-radius: 18px;
                background: root.theme == "custom" ? Theme.glass : Theme.bright ? #fcfaf6 : #17171d;
                border-width: 1px;
                border-color: Theme.hover-line;
                TouchArea { }
                picker-box := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        Text { text: root.picker-track == "" ? "New playlist" : "Add to playlist"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                        Icon { glyph: "\u{e711}"; label: "Close"; size: 12px; clicked => { root.picker-open = false; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        name := SearchBox {
                            placeholder: "Name of a new playlist";
                            glyph: "\u{e710}";
                            init => { self.take-focus(); }
                            accepted(text) => { root.new-playlist(text, root.picker-track); root.picker-open = false; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Pill { text: "Create"; enabled: name.value != ""; clicked => { root.new-playlist(name.value, root.picker-track); root.picker-open = false; } }
                        }
                    }
                    if root.picker-track != "" && root.picker-lists.length == 0: Text { text: "You have no playlists to add songs to yet."; color: Theme.dim; wrap: word-wrap; }
                    if root.picker-track != "": ListView {
                        vertical-stretch: 1;
                        for p in root.picker-lists: LibraryItem {
                            card: p;
                            clicked => { root.add-to-playlist(p.uri, p.title, root.picker-track); root.picker-open = false; }
                            need-picture(kind, id) => { root.need-picture(kind, id); }
                        }
                    }
                }
            }
        }

        if root.jam-open && root.ready && !root.now-playing: Rectangle {
            width: root.width;
            height: root.height;
            TouchArea { clicked => { root.jam-open = false; } }
            FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.jam-open = false; return accept; }
                    return reject;
                }
            }
            Rectangle {
                x: root.width - 360px;
                y: root.height - 116px - self.height;
                width: 340px;
                height: jam-box.preferred-height;
                border-radius: 18px;
                background: root.theme == "custom" ? Theme.glass : Theme.bright ? #fcfaf6 : #17171d;
                border-width: 1px;
                border-color: Theme.hover-line;
                TouchArea { }
                jam-box := VerticalLayout {
                    padding: 22px;
                    spacing: 12px;
                    Text { text: root.jam.length > 0 ? "Jam" : "No Jam right now"; color: Theme.text; font-size: 18px; font-weight: 700; }
                    if root.jam.length == 0: Text { text: "Start or join one in the Spotify app and pick Rustbeat as the speaker. It shows up here, and Rustbeat leaves the order of songs to the Jam."; color: Theme.dim; wrap: word-wrap; }
                    for name in root.jam: HorizontalLayout {
                        spacing: 10px;
                        Text { width: 18px; text: "\u{e77b}"; font-family: Theme.icons; color: Theme.accent; vertical-alignment: center; }
                        Text { text: name; color: Theme.text; overflow: elide; vertical-alignment: center; }
                    }
                    if root.jam-link != "": HorizontalLayout { alignment: start; Pill { quiet: true; text: "Copy invite link"; clicked => { root.copy-jam-link(); } } }
                }
            }
        }

        // Says something where it can't be missed.
        if root.toast != "": Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - 176px;
            width: min(root.width - 80px, toast-text.preferred-width + 48px);
            height: max(46px, toast-text.preferred-height + 22px);
            border-radius: 23px;
            background: root.theme == "custom" ? Theme.glass : Theme.bright ? #fffffff5 : #16161cf5;
            border-width: 1px;
            border-color: Theme.hover-line;
            accessible-role: text;
            accessible-label: root.toast;
            toast-text := Text { text: root.toast; color: Theme.text; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
        }

        if root.blocked: Rectangle {
            width: root.width;
            height: root.height;
            background: #000000a6;
            TouchArea { }
            FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.blocked = false; return accept; }
                    return reject;
                }
            }
            Rectangle {
                width: min(560px, root.width - 64px);
                height: dialog.preferred-height;
                border-radius: 24px;
                background: root.theme == "custom" ? Theme.glass : Theme.bright ? #fcfaf6 : #17171d;
                border-width: 1px;
                border-color: Theme.hover-line;
                dialog := VerticalLayout {
                    padding: 34px;
                    spacing: 16px;
                    Text { text: "Spotify won't let this account play here yet"; color: Theme.text; font-size: 22px; font-weight: 700; wrap: word-wrap; }
                    Text { text: "Rustbeat found the song, but Spotify refused to unlock it for the built-in player. It does that for newer accounts, and no app can change it."; color: Theme.dim; wrap: word-wrap; }
                    Text { text: "Soloist is Spotify's own small player, and Rustbeat can play through it. It takes a download, a free key from Spotify, and picking Rustbeat once in the Spotify app."; color: Theme.dim; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Pill { text: "Set up Soloist"; clicked => { root.blocked = false; root.now-playing = false; root.settings-open = true; } }
                        VerticalLayout { alignment: center; Pill { quiet: true; text: "Not now"; clicked => { root.blocked = false; } } }
                    }
                }
            }
        }
    }

    // Minimize, maximize and close, at the top right of every page.
    HorizontalLayout {
        width: 3 * 36px + 2 * 2px;
        x: root.width - self.width - 14px;
        y: 17px;
        height: 36px;
        spacing: 2px;
        opacity: root.chrome-shown || !root.now-playing ? 1 : 0;
        animate opacity { duration: Theme.quick * 2.4; }
        Icon { glyph: "\u{e921}"; label: "Minimize"; size: 11px; clicked => { root.window-minimize(); } }
        Icon { glyph: root.is-maximized ? "\u{e923}" : "\u{e922}"; label: root.is-maximized ? "Restore" : "Maximize"; size: 11px; clicked => { root.window-maximize(); } }
        Icon { glyph: "\u{e8bb}"; label: "Close"; size: 11px; clicked => { root.window-close(); } }
    }

    // Edges and corners that resize the window; the numbers are ResizeDirection in main.rs.
    if !root.is-maximized: Rectangle {
        for side in [
            { d: 0, x: 5px, y: 0px, w: root.width - 10px, h: 5px, c: MouseCursor.ns-resize },
            { d: 1, x: 5px, y: root.height - 5px, w: root.width - 10px, h: 5px, c: MouseCursor.ns-resize },
            { d: 2, x: 0px, y: 5px, w: 5px, h: root.height - 10px, c: MouseCursor.ew-resize },
            { d: 3, x: root.width - 5px, y: 5px, w: 5px, h: root.height - 10px, c: MouseCursor.ew-resize },
            { d: 4, x: 0px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
            { d: 5, x: root.width - 10px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
            { d: 6, x: 0px, y: root.height - 10px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
            { d: 7, x: root.width - 10px, y: root.height - 10px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
        ]: TouchArea {
            x: side.x;
            y: side.y;
            width: side.w;
            height: side.h;
            mouse-cursor: side.c;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.window-resize(side.d); } }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("icon.svg");
    tooltip: "Rustbeat";
    in property <bool> playing;
    callback show-window();
    callback toggle();
    callback next();
    callback quit();
    clicked => { root.show-window(); }
    Menu {
        MenuItem { title: "Open Rustbeat"; activated => { root.show-window(); } }
        MenuItem { title: root.playing ? "Pause" : "Play"; activated => { root.toggle(); } }
        MenuItem { title: "Next"; activated => { root.next(); } }
        MenuSeparator {}
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}
