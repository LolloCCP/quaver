import { ScrollView, AboutSlint } from "std-widgets.slint";
export struct ThemeCard { id: string, name: string, preview: image }
export struct Version { tag: string, about: string, used: bool }

import { Theme, Scene, Glass, PointerLight, KeyFocus, Icon, Pill, Switch, Bar, EqBand, Custom, ColorPicker, SecretBox, Link, Cover, Transport, Timeline, Playing } from "glass.slint";

export struct TrackRow { uri: string, title: string, artist: string, artist-uri: string, album: string, album-uri: string, duration: string, cover-id: string, cover: image, has-cover: bool, liked: bool }

export component Row inherits Rectangle {
    in property <TrackRow> item;
    in property <bool> current;
    in property <bool> lit;
    // Liking and playlists need Spotify; offline files have neither.
    in property <bool> can-save: true;
    // In a playlist one may change: the song can be moved and taken out.
    in property <bool> editable;
    in property <bool> first;
    in property <bool> last;
    // Where it is among how many, so a drag stays inside the list.
    in property <int> index;
    in property <int> count;
    // The queue's songs are taken out of the queue, not out of a playlist.
    in property <bool> in-queue;
    callback remove();
    callback move-up();
    callback move-down();
    // Rows down (or up, if less than 0) the song was dragged.
    callback drag-to(int);
    property <int> steps;
    z: root.steps != 0 ? 1 : 0;
    callback play();
    callback enqueue();
    callback like(bool);
    callback add-to();
    callback open(string, string);
    callback need-cover(string);
    property <length> slide: root.lit ? 8px : 0px;
    animate slide { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    init => { if (!item.has-cover && item.cover-id != "") { root.need-cover(item.cover-id); } }
    height: 60px;
    accessible-role: list-item;
    accessible-label: item.title + ", " + item.artist;
    accessible-action-default => { root.play(); }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return) { root.play(); return accept; }
            return reject;
        }
    }
    TouchArea { double-clicked => { root.play(); } }
    // Where a dragged song will go: under the row it passes going down, over it going up.
    if root.steps != 0: Rectangle {
        x: 12px;
        width: parent.width - 24px;
        y: (root.steps > 0 ? root.steps + 1 : root.steps) * root.height - 1px;
        height: 3px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        if root.current || root.lit || focus.has-focus: Rectangle {
            y: 2px;
            height: parent.height - 4px;
            border-radius: 16px;
            background: Theme.selected;
            border-width: focus.has-focus ? 2px : 1px;
            border-color: focus.has-focus ? Theme.accent : root.lit ? Theme.hover-line : Theme.line;
            Rectangle {
                x: 4px;
                width: 3px;
                height: root.current ? 32px : 18px;
                border-radius: 2px;
                background: @linear-gradient(180deg, Theme.fill 0%, Theme.fill2 100%);
            }
        }
        HorizontalLayout {
            padding-left: 10px + root.slide;
            padding-right: 8px;
            spacing: 14px;
            VerticalLayout {
                width: 48px;
                alignment: center;
                // The picture already has its rounded corners and gloss (art::jewel).
                cover-touch := TouchArea {
                    height: 48px;
                    mouse-cursor: pointer;
                    clicked => { root.play(); }
                    Image { width: 48px; height: 48px; source: item.cover; opacity: item.has-cover ? 1 : 0; animate opacity { duration: Theme.quick * 1.5; } }
                    if !item.has-cover: Rectangle { border-radius: 10px; background: Theme.raised; Text { text: "\u{e8d6}"; font-family: Theme.icons; font-size: 16px; color: Theme.dim; horizontal-alignment: center; vertical-alignment: center; } }
                    if root.lit: Rectangle {
                        border-radius: 10px;
                        background: #00000080;
                        border-width: cover-touch.has-hover ? 2px : 0px;
                        border-color: Theme.accent;
                        Text { text: "\u{e768}"; font-family: Theme.icons; font-size: cover-touch.has-hover ? 22px : 18px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 6;
                preferred-width: 0px;
                min-width: 0px;
                alignment: center;
                spacing: 0px;
                Text { text: item.title; overflow: elide; font-weight: root.current ? 600 : 400; color: root.current ? Theme.accent : Theme.text; }
                Link { height: 24px; text: item.artist; linked: item.artist-uri != ""; clicked => { root.open(item.artist, item.artist-uri); } }
            }
            Link { text: item.album; linked: item.album-uri != ""; preferred-width: 0px; horizontal-stretch: 4; clicked => { root.open(item.album, item.album-uri); } }
            Text { text: item.duration; width: 44px; horizontal-alignment: right; vertical-alignment: center; color: Theme.dim; }
            if root.can-save: VerticalLayout {
                alignment: center;
                // A liked song always shows its heart; the others only on hover.
                Icon {
                    opacity: item.liked || root.lit ? 1 : 0;
                    glyph: item.liked ? "\u{eb52}" : "\u{eb51}";
                    on: item.liked;
                    label: (item.liked ? "Remove from Liked Songs: " : "Add to Liked Songs: ") + item.title;
                    size: 13px;
                    clicked => { root.like(!item.liked); }
                }
            }
            if root.can-save: VerticalLayout {
                alignment: center;
                Icon { opacity: root.lit ? 1 : 0; glyph: "\u{ecc8}"; label: "Add to playlist: " + item.title; size: 13px; clicked => { root.add-to(); } }
            }
            // Mouse only; the buttons beside it do the same from the keyboard.
            // shortcut: the list doesn't scroll while dragging, so a song goes at most a screen at a time; scroll in steps for longer moves.
            if root.editable: VerticalLayout {
                alignment: center;
                grip := TouchArea {
                    width: 24px;
                    height: 32px;
                    mouse-cursor: self.pressed ? grabbing : grab;
                    moved => { root.steps = max(-root.index, min(root.count - 1 - root.index, round((self.mouse-y - self.pressed-y) / root.height))); }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up && root.steps != 0) { root.drag-to(root.steps); }
                        if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { root.steps = 0; }
                    }
                    Text { text: "\u{e76f}"; font-family: Theme.icons; font-size: 13px; color: grip.has-hover || grip.pressed ? Theme.text : Theme.dim; opacity: root.lit || grip.pressed ? 1 : 0; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                }
            }
            if root.editable: VerticalLayout {
                alignment: center;
                Icon { opacity: root.lit && !root.first ? 1 : 0; enabled: !root.first; glyph: "\u{e70e}"; label: "Move up: " + item.title; size: 13px; clicked => { root.move-up(); } }
            }
            if root.editable: VerticalLayout {
                alignment: center;
                Icon { opacity: root.lit && !root.last ? 1 : 0; enabled: !root.last; glyph: "\u{e70d}"; label: "Move down: " + item.title; size: 13px; clicked => { root.move-down(); } }
            }
            if root.editable: VerticalLayout {
                alignment: center;
                Icon { opacity: root.lit ? 1 : 0; glyph: "\u{e74d}"; label: (root.in-queue ? "Remove from queue: " : "Remove from this playlist: ") + item.title; size: 13px; clicked => { root.remove(); } }
            }
            VerticalLayout {
                alignment: center;
                Icon { glyph: "\u{e710}"; label: "Add to queue: " + item.title; size: 13px; clicked => { root.enqueue(); } }
            }
        }
    }
}

component Lyrics inherits Rectangle {
    in property <[string]> lines;
    in property <int> active;
    in property <bool> synced;
    in property <string> note;
    callback seek(int);
    // Timed lyrics follow the song again a few seconds after being scrolled by hand.
    property <bool> by-hand;
    property <int> flicks;
    property <int> seen-flicks;
    Timer {
        interval: 2s;
        running: root.by-hand;
        triggered => {
            root.by-hand = root.flicks != root.seen-flicks;
            root.seen-flicks = root.flicks;
        }
    }
    property <int> look;
    Timer { interval: 1s; running: root.synced && !root.by-hand && Theme.motion; triggered => { root.look += 1; } }

    // Everything moves on the frame clock, as in karaoke: Slint doesn't animate values here that
    // change from code. `pos` is where the lyrics are, in lines; it glides from one line to the next.
    property <float> from;
    property <float> to;
    property <duration> started;
    property <bool> gliding;
    init => { root.from = root.active; root.to = root.active; }
    changed active => {
        root.from = root.pos;
        root.to = root.active;
        root.started = animation-tick();
        root.gliding = Theme.motion;
    }
    property <float> k: root.gliding ? min(1, (animation-tick() - root.started) / (Theme.quick * 2)) : 1;
    // Eases in and out, so a line neither starts nor stops with a jolt.
    property <float> pos: root.from + (root.to - root.from) * (root.k < 0.5 ? 4 * root.k * root.k * root.k : 1 - pow(2 - 2 * root.k, 3) / 2);

    // The scroll to the sung line moves off at once and settles softly.
    property <length> scroll-from;
    property <length> scroll-to;
    property <duration> scroll-started;
    property <bool> scrolling;
    property <float> sk: root.scrolling ? min(1, (animation-tick() - root.scroll-started) / (Theme.quick * 4)) : 1;
    property <length> scroll-y: root.scroll-from + (root.scroll-to - root.scroll-from) * (1 - pow(1 - root.sk, 3));
    changed scroll-y => { if (root.scrolling && !root.by-hand) { flick.content-y = root.scroll-y; } }
    // A new line starts a new glide; a line that only moves (as sizes change) keeps the glide going.
    function scroll(y: length, again: bool) {
        if (!Theme.motion) {
            root.scrolling = false;
            flick.content-y = y;
        } else if (again || !root.scrolling) {
            root.scroll-from = flick.content-y;
            root.scroll-to = y;
            root.scroll-started = animation-tick();
            root.scrolling = true;
        } else {
            root.scroll-to = y;
        }
    }
    Timer {
        interval: 100ms;
        running: root.gliding || root.scrolling;
        triggered => {
            if (root.gliding && animation-tick() - root.started >= Theme.quick * 2) { root.gliding = false; }
            if (root.scrolling && animation-tick() - root.scroll-started >= Theme.quick * 4) {
                root.scrolling = false;
                if (!root.by-hand) { flick.content-y = root.scroll-to; }
            }
        }
    }
    clip: true;
    if root.lines.length == 0: Text { text: root.note; color: Theme.dim; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
    flick := Flickable {
        width: 100%;
        height: 100%;
        content-height: column.preferred-height;
        flicked => {
            root.by-hand = true;
            root.scrolling = false;
            root.flicks += 1;
        }
        column := VerticalLayout {
            width: root.width;
            padding-top: root.synced ? root.height * 0.4 : 8px;
            padding-bottom: root.synced ? root.height * 0.5 : 8px;
            spacing: 14px;
            for line[i] in root.lines: line-area := TouchArea {
                property <bool> active: root.synced && i == root.active;
                property <bool> follow: !root.by-hand;
                property <length> indent: root.synced && self.has-hover ? 10px : 0px;
                animate indent { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                property <length> target: root.height * 0.4 - self.y;
                property <int> look: root.look;
                changed follow => { self.center(true); }
                // A press on the lyrics stops them on their way; this brings the line home.
                changed look => { if (!root.scrolling && abs((flick.content-y - self.target) / 1px) > 1) { self.center(true); } }
                function center(again: bool) { if (self.active && self.follow) { root.scroll(self.target, again); } }
                // Lyrics that arrive in the middle of a line, or a resize, go there at once.
                init => { if (self.active && self.follow) { flick.content-y = self.target; } }
                changed active => { self.center(true); }
                changed y => { self.center(false); }
                height: words.preferred-height;
                mouse-cursor: root.synced ? MouseCursor.pointer : MouseCursor.default;
                clicked => { if (root.synced) { root.seek(i); } }
                // How far from where the lyrics are, in lines: 0 for the sung line, gliding in between.
                property <float> d: i - root.pos;
                property <float> far: abs(self.d);
                property <float> near: min(1, self.far);
                // Lines fade out over the last 70px at the top and bottom, and a line that doesn't fit is hidden.
                property <length> shown-y: self.y + flick.content-y;
                property <float> edge: max(0, min(1, min(self.shown-y, root.height - self.shown-y - self.height) / 70px));
                // With a chosen number of lines around the sung one, the outer two fade out step by step
                // (to 0.8 and 0.4 of their light), and the ones past them are hidden.
                property <float> kept: !root.synced || Theme.lyric-lines == 0 ? 1 : max(1 - self.far, min(1, (Theme.lyric-lines / 2 + 0.5 - self.far) / 2.5));
                // The others dim the further away they are, sung ones a little more.
                property <float> dim: self.far < 1 ? 1 - 0.38 * self.far : max(0.22, 0.62 - (self.far - 1) * 0.13);
                property <float> side: self.d < 0 ? 1 - 0.2 * min(1, -self.d) : 1;
                opacity: !root.synced || self.has-hover ? self.edge : max(0, self.kept) * self.edge * self.dim * self.side;
                words := Text {
                    x: line-area.indent;
                    // Timed lines wrap as they would at the sung size, so growing never moves the line breaks.
                    width: root.synced ? (root.width - 24px) * self.font-size / 32px : root.width - 24px;
                    text: line == "" ? "♪" : line;
                    wrap: word-wrap;
                    // Whole pixels: the renderer caches letters for every size it is asked for.
                    font-size: !root.synced ? 18px : round((32 - 10 * line-area.near)) * 1px;
                    font-weight: root.synced ? 700 : 400;
                    color: line-area.has-hover && root.synced && !line-area.active ? Theme.accent : Theme.text;
                    animate color { duration: Theme.quick * 1.5; }
                }
            }
        }
    }
}


// One line of karaoke. `d` is how many lines away from the one being sung it is, in fractions while
// moving, so size, place and fade all glide together. Lines a line or more away are small; the one
// being sung grows into the space between them.
component SungLine inherits TouchArea {
    in property <string> words;
    in property <float> d;
    in property <length> big;
    in property <length> middle;
    // How far from the middle lines stay visible; past it they fade out.
    in property <length> band: 10000px;
    property <length> small: root.big * 0.5;
    property <length> big-slot: root.big * 1.55;
    property <length> small-slot: root.small * 1.9;
    property <float> near: min(abs(root.d), 1);
    property <length> slot: root.big-slot + (root.small-slot - root.big-slot) * root.near;
    property <length> offset: root.d * root.small-slot + (root.d < 0 ? -1 : 1) * root.near * (root.big-slot - root.small-slot) / 2;
    // A long line shrinks to stay on one row, the same at every size.
    // Letters don't grow exactly in step with the size, so it leaves a little room.
    property <float> fit: max(0.45, min(1, root.width * 0.97 / max(1px, measure.preferred-width)));
    visible: abs(root.d) < 6;
    y: root.middle + root.offset - root.slot / 2;
    height: root.slot;
    mouse-cursor: pointer;
    // Sung lines fade a little more than the ones to come.
    property <float> edge: max(0, min(1, (root.band - abs(root.offset)) / (root.small-slot * 1.2)));
    opacity: root.edge * (root.near < 1 ? 1 - root.near * 0.62 : max(0, 0.38 - (abs(root.d) - 1) * 0.1) * (root.d < 0 ? 0.7 : 1));
    measure := Text { visible: false; text: root.words; font-size: root.big; font-weight: 800; }
    Image {
        visible: root.near < 1;
        x: -root.big; y: (root.height - self.height) / 2;
        width: min(root.width, measure.preferred-width * root.fit) + root.big * 2; height: root.big * 3;
        source: Theme.glow; colorize: Theme.fill; opacity: 0.16 * (1 - root.near);
    }
    Text {
        width: root.width;
        height: root.height;
        text: root.words;
        // Whole pixels: the renderer caches letters for every size it is asked for. Rounded down,
        // since rounding up would make a line that fills the row a little too wide for it.
        font-size: floor((root.big + (root.small - root.big) * root.near) * root.fit / 1px) * 1px;
        font-weight: 800;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Sing-along, made to be left on a second screen: the cover on one side, the lyrics gliding by on the other.
component Karaoke inherits Rectangle {
    in property <[string]> lines;
    in property <int> active;
    in property <bool> synced;
    in property <string> note;
    in property <image> cover;
    in property <bool> has-cover;
    // Drawn by Rust in the chosen style: the cover or record, and a sleeve or mirror image.
    in property <image> art;
    in property <image> extra;
    // The cover blurred, drawn by Rust at screen size.
    in property <image> haze;
    in property <int> art-style;
    in property <bool> controls;
    in property <string> title;
    in property <string> artist;
    in property <string> artist-uri;
    in property <string> album;
    callback open-artist();
    callback seek(int);
    callback set-style(int);
    callback art-resized(length);
    out property <bool> wide: root.width >= 900px;
    out property <length> side: root.wide ? root.width * 0.42 : 0px;
    property <length> unit: max(120px, min(root.side - 110px, root.height - 330px, 560px));
    // A record sticks out of its sleeve, and a mirror image needs room below.
    property <length> art-size: root.art-style == 1 ? root.unit * 0.72 : root.art-style == 3 ? root.unit * 0.82 : root.unit;
    init => { root.from = root.active; root.to = root.active; if (root.wide) { root.art-resized(root.art-size); } }
    changed art-size => { if (root.wide) { root.art-resized(root.art-size); } }
    // Where the lyrics are, in lines. It glides from one line to the next on the frame clock: Slint
    // doesn't animate a value set from code here, and this asks for frames only while it moves.
    property <float> from;
    property <float> to;
    property <duration> started;
    property <bool> gliding;
    changed active => {
        root.from = root.pos;
        root.to = root.active;
        root.started = animation-tick();
        root.gliding = Theme.motion;
    }
    // 500ms: main.rs starts each line this early, so the glide ends as it is sung.
    property <float> k: root.gliding ? min(1, (animation-tick() - root.started) / 500ms) : 1;
    // Eases in and out, so a line neither starts nor stops with a jolt.
    property <float> pos: root.from + (root.to - root.from) * (root.k < 0.5 ? 4 * root.k * root.k * root.k : 1 - pow(2 - 2 * root.k, 3) / 2);
    Timer { interval: 100ms; running: root.gliding; triggered => { if (animation-tick() - root.started >= 500ms) { root.gliding = false; } } }
    background: #040306;
    clip: true;

    if root.has-cover: Image { width: 100%; height: 100%; source: root.haze; image-fit: ImageFit.fill; opacity: 0.3; }
    Image { x: -root.width * 0.25; y: root.height * 0.35; width: root.width * 0.9; height: self.width; source: Theme.glow; colorize: Theme.fill; opacity: 0.32; }
    Image { x: root.width * 0.45; y: -root.width * 0.4; width: root.width * 0.8; height: self.width; source: Theme.glow; colorize: Theme.fill2; opacity: 0.24; }
    Rectangle { background: @radial-gradient(circle, #04030600 0%, #04030699 55%, #040306f2 100%); }

    // The cover with what is playing and the controls under it; on a narrow window only the controls, at the bottom.
    // With the UI hidden, what is under the cover is invisible, so the cover moves down to the middle.
    property <length> info-height;
    // The cover's top edge; the lyrics line up with the cover between it and its bottom.
    property <length> art-top;
    VerticalLayout {
        x: 0;
        y: root.wide && !root.controls ? (root.info-height + below.height + 12px) / 2 : 0px;
        animate y { duration: Theme.quick * 3; easing: ease-in-out; }
        width: root.wide ? root.side : root.width;
        height: root.height;
        alignment: root.wide ? LayoutAlignment.center : LayoutAlignment.end;
        padding-bottom: root.wide ? 0px : 18px;
        spacing: 6px;
        if root.wide: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.art-style == 1 ? root.art-size * 1.4 : root.art-size;
                height: root.art-style == 3 ? root.art-size * 1.38 : root.art-size;
                // Tells the lyrics where the cover is, as it moves.
                property <length> top: self.absolute-position.y - root.absolute-position.y;
                init => { root.art-top = self.top; }
                changed top => { root.art-top = self.top; }
                Image { x: -parent.width * 0.3; y: -root.art-size * 0.3; width: parent.width * 1.6; height: root.art-size * 1.6; source: Theme.glow; colorize: Theme.fill; opacity: 0.45; }
                if root.art-style == 1: Image {
                    // The record slides out of its sleeve while it plays.
                    x: root.art-size * (Playing.playing ? 0.4 : 0.16);
                    animate x { duration: Theme.quick * 5; easing: cubic-bezier(0.3, 0.7, 0.2, 1); }
                    y: 0;
                    width: root.art-size;
                    height: root.art-size;
                    source: root.art;
                }
                Rectangle {
                    x: 0; y: 0;
                    width: root.art-size; height: root.art-size;
                    border-radius: root.art-style == 2 ? root.art-size / 2 : root.art-size * 0.03;
                    drop-shadow-blur: 28px;
                    drop-shadow-offset-y: 10px;
                    drop-shadow-color: #00000099;
                    background: #00000001;
                }
                Image { x: 0; y: 0; width: root.art-size; height: root.art-size; source: root.art-style == 1 ? root.extra : root.art; }
                // The CD's shine stays still while the disc turns under it.
                if root.art-style == 2: Image { x: 0; y: 0; width: root.art-size; height: root.art-size; source: root.extra; }
                if root.art-style == 3: Image { x: 0; y: root.art-size + 4px; width: root.art-size; height: root.art-size * 0.35; source: root.extra; }
            }
        }
        if root.wide: VerticalLayout {
            init => { root.info-height = self.height; }
            changed height => { root.info-height = self.height; }
            padding-top: 22px;
            padding-left: 30px;
            padding-right: 30px;
            spacing: 4px;
            opacity: root.controls ? 1 : 0;
            animate opacity { duration: Theme.quick * 3; }
            Text { text: root.title; color: Theme.text; font-size: 24px; font-weight: 800; horizontal-alignment: center; overflow: elide; }
            Link { text: root.artist; linked: root.artist-uri != ""; color: Theme.accent; hover: Theme.text; font-size: 16px; horizontal-alignment: center; clicked => { root.open-artist(); } }
            HorizontalLayout {
                alignment: center;
                padding-top: 10px;
                spacing: 6px;
                for name[i] in ["Cover", "Vinyl", "CD", "Mirror"]: Pill { quiet: true; text: name; selected: root.art-style == i; clicked => { root.set-style(i); } }
            }
        }
        below := HorizontalLayout {
            alignment: center;
            padding-top: 8px;
            opacity: root.controls ? 1 : 0;
            animate opacity { duration: Theme.quick * 3; }
            @children
        }
    }
    if !root.wide: VerticalLayout {
        x: 32px; y: 24px; width: root.width - 260px; height: 46px; spacing: 2px;
        opacity: root.controls ? 1 : 0;
        animate opacity { duration: Theme.quick * 3; }
        Text { text: root.title; color: Theme.text.with-alpha(0.75); font-size: 14px; font-weight: 700; overflow: elide; }
        Link { text: root.artist; linked: root.artist-uri != ""; color: Theme.accent.with-alpha(0.75); hover: Theme.text; font-size: 12px; clicked => { root.open-artist(); } }
    }

    lyric := Rectangle {
        x: root.wide ? root.side + 20px : 40px;
        width: root.width - self.x - 60px;
        y: root.wide ? 40px : 80px;
        height: root.height - (root.wide ? 80px : 200px);
        property <length> big: max(30px, min(60px, self.width / 15));
        // Level with the cover's middle, fading out where its top and bottom are.
        property <length> middle: root.wide ? root.art-top + root.art-size / 2 - self.y : self.height * 0.45;
        property <length> band: root.wide ? root.art-size / 2 : 10000px;
        if !root.synced || root.lines.length == 0: Text {
            width: parent.width;
            text: root.lines.length == 0 ? root.note : "These lyrics aren't timed, so there's nothing to sing along to.";
            color: Theme.dim; font-size: 20px; vertical-alignment: center; wrap: word-wrap;
        }
        if root.synced: Rectangle {
            // Before the first line, dots wait where it will be sung.
            SungLine { width: parent.width; words: "•  •  •"; d: -1 - root.pos; big: lyric.big; middle: lyric.middle; band: lyric.band; }
            for line[i] in root.lines: SungLine {
                width: parent.width;
                words: line == "" ? "•  •  •" : line;
                d: i - root.pos;
                big: lyric.big;
                middle: lyric.middle;
                band: lyric.band;
                clicked => { root.seek(i); }
            }
        }
    }
}

export component NowPlaying inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> artist-uri;
    callback open-artist();
    in property <string> album;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    in property <bool> lyrics-open;
    in property <[string]> lyrics;
    in property <int> lyrics-active;
    in property <bool> lyrics-synced;
    in property <string> lyrics-note;
    in property <bool> karaoke;
    in property <bool> track-liked;
    in property <bool> can-save;
    callback like-playing();
    callback add-playing();
    in property <float> volume;
    callback set-volume(float);
    in property <image> stage-art;
    in property <image> stage-extra;
    in property <image> stage-haze;
    in property <int> stage-style;
    callback set-stage(int);
    callback stage-resized(length);
    callback toggle-karaoke();
    callback toggle();
    callback next();
    callback prev();
    callback set-shuffle(bool);
    callback set-repeat(int);
    callback seek(float);
    callback seek-line(int);
    callback toggle-lyrics();
    callback close();
    callback fullscreen();
    callback window-drag();
    callback window-maximize();
    callback controls-changed(bool);
    // Controls fade after a moment without the mouse, but never while paused; karaoke leaves only
    // the cover and the lyrics after five seconds, paused or not.
    property <int> idle;
    property <bool> awake: root.idle < (root.karaoke ? 20 : 12);
    property <bool> controls: root.awake || (!root.playing && !root.karaoke);
    property <duration> last-press;
    property <length> left: root.lyrics-open ? min(root.width * 0.46, 620px) : root.width;
    property <length> art: min(root.left - 96px, root.height - 330px, 560px);
    property <length> last-x;
    property <length> last-y;
    callback art-resized(length);
    init => { root.art-resized(root.art); }
    changed art => { root.art-resized(root.art); }

    Timer { interval: 250ms; running: root.awake && (root.playing || root.karaoke); triggered => { root.idle += 1; } }
    TouchArea {
        mouse-cursor: root.controls ? MouseCursor.default : MouseCursor.none;
        // Slint repeats the last position after a relayout, which isn't a real movement.
        pointer-event(e) => {
            // The empty page moves the window, like the title bar it replaces.
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                if (animation-tick() - root.last-press < 400ms) { root.window-maximize(); }
                root.last-press = animation-tick();
            }
            // The drag starts on movement only; see the top strip in app.slint.
            if (e.kind == PointerEventKind.move && self.pressed && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px)) {
                root.window-drag();
            }
            if (e.kind != PointerEventKind.move || self.mouse-x != root.last-x || self.mouse-y != root.last-y) {
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
                root.idle = 0;
            }
        }
    }
    VerticalLayout {
        visible: !root.karaoke;
        x: 0;
        width: root.left;
        padding-left: 32px;
        padding-right: 32px;
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.art;
                height: root.art;
                // The cover's glow.
                Image { x: -root.art * 0.18; y: -root.art * 0.12; width: root.art * 1.36; height: root.art * 1.36; source: Theme.glow; colorize: Theme.fill; opacity: 0.55; }
                // The picture leans towards the pointer, and light slides over it.
                property <length> lean-x: Theme.motion && Scene.hovering ? max(-7px, min(7px, (Scene.mouse-x - root.left / 2) * 0.02)) : 0px;
                property <length> lean-y: Theme.motion && Scene.hovering ? max(-7px, min(7px, (Scene.mouse-y - root.height / 2) * 0.02)) : 0px;
                animate lean-x, lean-y { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                Rectangle {
                    x: parent.lean-x;
                    y: parent.lean-y;
                    width: root.art;
                    height: root.art;
                    Cover {
                        width: 100%;
                        height: 100%;
                        source: root.cover;
                        loaded: root.has-cover;
                        clip: true;
                        PointerLight { hue: white; strength: 0.4; size: 360px; }
                    }
                }
            }
        }
        Rectangle { height: 16px; }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            // As wide as the buttons after the title, so the title stays in the middle.
            if root.can-save: Rectangle { width: 2 * 36px + 6px; }
            Text { text: root.title; font-size: 30px; font-weight: 700; color: Theme.text; overflow: elide; min-width: 0px; }
            if root.can-save: VerticalLayout { alignment: center; Icon { glyph: root.track-liked ? "\u{eb52}" : "\u{eb51}"; on: root.track-liked; label: root.track-liked ? "Remove from Liked Songs" : "Add to Liked Songs"; clicked => { root.like-playing(); } } }
            if root.can-save: VerticalLayout { alignment: center; Icon { glyph: "\u{ecc8}"; label: "Add to playlist"; clicked => { root.add-playing(); } } }
        }
        Link { text: root.artist; linked: root.artist-uri != ""; font-size: 18px; color: Theme.accent; hover: Theme.text; horizontal-alignment: center; clicked => { root.open-artist(); } }
        Text { text: root.album; color: Theme.dim; horizontal-alignment: center; overflow: elide; }
        HorizontalLayout {
            alignment: center;
            padding-top: 14px;
            Glass {
                width: min(root.left - 64px, 560px);
                height: 132px;
                opacity: root.controls ? 1 : 0;
                animate opacity { duration: Theme.quick * 2.4; }
                VerticalLayout {
                    padding: 12px;
                    alignment: center;
                    spacing: 8px;
                    Timeline { progress: root.progress; elapsed: root.elapsed; total: root.total; seek(v) => { root.idle = 0; root.seek(v); } }
                    Transport {
                        size: 58px;
                        playing: root.playing;
                        shuffle: root.shuffle;
                        repeat: root.repeat;
                        toggle => { root.idle = 0; root.toggle(); }
                        next => { root.idle = 0; root.next(); }
                        prev => { root.idle = 0; root.prev(); }
                        set-shuffle(on) => { root.idle = 0; root.set-shuffle(on); }
                        set-repeat(m) => { root.idle = 0; root.set-repeat(m); }
                    }
                }
            }
        }
    }
    if root.lyrics-open && !root.karaoke: Lyrics {
        x: root.left;
        y: 76px;
        width: root.width - root.left - 48px;
        height: root.height - 124px;
        lines: root.lyrics;
        active: root.lyrics-active;
        synced: root.lyrics-synced;
        note: root.lyrics-note;
        seek(i) => { root.seek-line(i); }
    }
    if root.karaoke: Karaoke {
        width: 100%;
        height: 100%;
        lines: root.lyrics;
        active: root.lyrics-active;
        synced: root.lyrics-synced;
        note: root.lyrics-note;
        cover: root.cover;
        has-cover: root.has-cover;
        art: root.stage-art;
        extra: root.stage-extra;
        haze: root.stage-haze;
        art-style: root.stage-style;
        controls: root.controls;
        title: root.title;
        artist: root.artist;
        artist-uri: root.artist-uri;
        open-artist => { root.open-artist(); }
        album: root.album;
        seek(i) => { root.seek-line(i); }
        set-style(i) => { root.idle = 0; root.set-stage(i); }
        art-resized(size) => { root.stage-resized(size); }
        Glass {
            width: min(parent.width - 48px, 460px);
            height: 96px;
            VerticalLayout {
                padding: 10px;
                alignment: center;
                spacing: 4px;
                Timeline { progress: root.progress; elapsed: root.elapsed; total: root.total; seek(v) => { root.idle = 0; root.seek(v); } }
                Transport {
                    size: 44px;
                    playing: root.playing;
                    shuffle: root.shuffle;
                    repeat: root.repeat;
                    toggle => { root.idle = 0; root.toggle(); }
                    next => { root.idle = 0; root.next(); }
                    prev => { root.idle = 0; root.prev(); }
                    set-shuffle(on) => { root.idle = 0; root.set-shuffle(on); }
                    set-repeat(m) => { root.idle = 0; root.set-repeat(m); }
                }
            }
        }
    }
    // Opened by the speaker button, under the buttons; it goes with them when the mouse rests.
    property <bool> volume-open;
    changed controls => { root.controls-changed(root.controls); if (!root.controls) { root.volume-open = false; } }
    if root.volume-open: Glass {
        x: root.width - 362px;
        y: 70px;
        width: 236px;
        height: 50px;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 16px;
            spacing: 10px;
            Text { text: "\u{e767}"; font-family: Theme.icons; color: Theme.dim; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Bar { value: root.volume; label: "Volume"; live: true; commit(v) => { root.idle = 0; root.set-volume(v); } }
            }
            Text { width: 34px; text: round(root.volume * 100) + "%"; color: Theme.dim; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
        }
    }
    Glass {
        x: root.width - 350px;
        y: 14px;
        width: 224px;
        height: 50px;
        opacity: root.controls ? 1 : 0;
        animate opacity { duration: Theme.quick * 2.4; }
        HorizontalLayout {
            padding: 7px;
            spacing: 6px;
            alignment: center;
            Icon { glyph: root.volume <= 0 ? "\u{e74f}" : "\u{e767}"; label: "Volume"; on: root.volume-open; clicked => { root.idle = 0; root.volume-open = !root.volume-open; } }
            Icon { glyph: "\u{e720}"; label: root.karaoke ? "Leave karaoke" : "Karaoke"; on: root.karaoke; clicked => { root.toggle-karaoke(); } }
            Icon { glyph: "\u{e8bd}"; label: root.lyrics-open ? "Hide lyrics" : "Show lyrics"; on: root.lyrics-open; enabled: !root.karaoke; clicked => { root.toggle-lyrics(); } }
            Icon { glyph: "\u{e740}"; label: "Full screen"; clicked => { root.fullscreen(); } }
            Icon { glyph: "\u{e70d}"; label: "Close now playing"; clicked => { root.close(); } }
        }
    }
}

component VersionRow inherits HorizontalLayout {
    in property <Version> v;
    in property <bool> updating;
    callback use(string);
    spacing: 12px;
    Text { width: 80px; text: root.v.tag; color: root.v.used ? Theme.accent : Theme.text; vertical-alignment: center; overflow: elide; }
    Text { text: root.v.about; color: Theme.dim; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
    VerticalLayout { alignment: center; Pill { quiet: true; enabled: !root.updating && !root.v.used; selected: root.v.used; text: root.v.used ? "In use" : "Use"; clicked => { root.use(root.v.tag); } } }
}

component Section inherits VerticalLayout {
    in property <string> text;
    spacing: 10px;
    padding-bottom: 22px;
    Text { text: root.text; font-size: 18px; font-weight: 600; color: Theme.text; }
    @children
}

export component SettingsView inherits ScrollView {
    in property <bool> eq-on;
    in property <[float]> eq;
    in property <[string]> presets;
    in property <int> bitrate;
    in property <bool> normalise;
    in property <bool> tray;
    in property <bool> updates;
    in property <bool> gpu;
    in property <bool> links;
    in property <bool> needs-restart;
    in property <bool> soloist;
    in property <bool> soloist-here;
    in property <bool> soloist-has-key;
    in property <bool> soloist-paired;
    property <bool> soloist-ready: root.soloist && root.soloist-paired;
    property <bool> new-key;
    property <int> soloist-step: !root.soloist-here ? 1 : !root.soloist-has-key || root.new-key ? 2 : !root.soloist ? 4 : 3;
    callback open-spotify();
    in property <string> version;
    in property <[Version]> versions;
    in property <bool> version-chosen;
    property <bool> older-open;
    in property <bool> updating;
    in property <bool> update-ready;
    in property <string> update-note;
    callback use-version(string);
    callback restart();
    in property <bool> downloading;
    in property <[ThemeCard]> themes;
    in property <string> theme;
    in property <bool> glass-theme;
    callback set-theme-id(string);
    callback soloist-about();
    in property <bool> offline;
    in property <string> music;
    callback set-offline(bool);
    callback choose-music();
    callback discord();
    in property <string> player-note;
    callback set-soloist(bool);
    callback soloist-key(string);
    callback soloist-folder();
    callback soloist-download();
    callback soloist-get-key();
    callback set-eq-on(bool);
    callback set-band(int, float);
    callback set-preset(int);
    callback set-bitrate(int);
    callback set-normalise(bool);
    callback set-tray(bool);
    callback set-updates(bool);
    callback set-tint(float);
    callback set-motion(bool);
    callback set-gpu(bool);
    callback set-links(bool);
    callback set-lyric-lines(int);
    callback logout();
    property <[string]> labels: ["31", "62", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"];
    content-width: self.visible-width;
    VerticalLayout {
        padding-left: 8px;
        padding-right: 22px;
        padding-top: 4px;
        Section {
            text: "Theme";
            Rectangle {
                property <int> columns: max(1, floor((self.width + 12px) / 200px));
                height: ceil(root.themes.length / self.columns) * 146px;
                for t[i] in root.themes: theme-card := TouchArea {
                    property <bool> chosen: root.theme == t.id;
                    x: mod(i, parent.columns) * 200px;
                    y: floor(i / parent.columns) * 146px;
                    width: 188px;
                    height: 138px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: t.name;
                    accessible-checked: self.chosen;
                    accessible-action-default => { root.set-theme-id(t.id); }
                    clicked => { root.set-theme-id(t.id); }
                    Rectangle {
                        border-radius: 14px;
                        background: theme-card.chosen || theme-card.has-hover ? Theme.selected : transparent;
                        border-width: theme-card.chosen || theme-focus.has-focus ? 2px : 1px;
                        border-color: theme-card.chosen || theme-focus.has-focus ? Theme.accent : Theme.line;
                    }
                    theme-focus := KeyFocus { activated => { root.set-theme-id(t.id); } }
                    Image { x: 6px; y: 6px; width: 176px; height: 103px; source: t.preview; }
                    Text { y: 111px; height: 24px; text: t.name; color: theme-card.chosen ? Theme.accent : Theme.text; font-weight: theme-card.chosen ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if root.glass-theme: HorizontalLayout {
                spacing: 16px;
                height: 40px;
                Text { text: "Glass"; color: Theme.text; vertical-alignment: center; }
                Text { text: "Clear"; color: Theme.dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: right; }
                VerticalLayout { alignment: center; Bar { width: 180px; live: true; label: "Glass darkness"; value: (Theme.tint - 0.2) / 0.65; commit(v) => { root.set-tint(0.2 + v * 0.65); } } }
                Text { text: "Dark"; color: Theme.dim; font-size: 12px; vertical-alignment: center; }
            }
            if root.theme == "custom": HorizontalLayout {
                spacing: 24px;
                ColorPicker { horizontal-stretch: 1; label: "Theme"; color: Custom.base; picked(c) => { Custom.picked(0, c); } typed(t) => { Custom.typed(0, t); } }
                ColorPicker { horizontal-stretch: 1; label: "Highlights"; color: Custom.highlight; picked(c) => { Custom.picked(1, c); } typed(t) => { Custom.typed(1, t); } }
            }
            Switch { text: "Motion effects"; note: "Animations, pointer light and gliding scrolling"; checked: Theme.motion; toggled(on) => { root.set-motion(on); } }
            Switch { text: "Hardware acceleration"; note: "Smoother movement, drawn by the graphics card. Applies after a restart"; checked: root.gpu; toggled(on) => { root.set-gpu(on); } }
            Switch { text: "Open Spotify links here"; note: "Song, album, playlist and artist links open in Rustbeat instead of the Spotify app"; checked: root.links; toggled(on) => { root.set-links(on); } }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Lyrics lines"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                for n in [1, 3, 5, 9, 0]: Pill { quiet: true; text: n == 0 ? "All" : n; selected: Theme.lyric-lines == n; clicked => { root.set-lyric-lines(n); } }
            }
        }
        Section {
            text: "Player";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Pill { quiet: true; text: "Built-in"; selected: !root.soloist; clicked => { if (root.soloist) { root.set-soloist(false); } } }
                Pill { quiet: true; text: "Spotify Soloist"; selected: root.soloist; clicked => { root.set-soloist(true); } }
            }
            Text { text: root.soloist ? "Spotify's own player makes the sound, lossless where Spotify has it. Streaming quality below doesn't reach it, and the equalizer applies from the next start." : "If songs are refused, Spotify doesn't allow the built-in player on your account. Soloist is Spotify's own player and works there."; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
            // Only what comes next, and nothing once it works.
            Text {
                text: root.soloist-step == 1 ? "Set up Soloist, step 1 of 3: download it from Spotify. By doing so you accept Spotify's terms."
                    : root.soloist-step == 2 ? "Set up Soloist, step 2 of 3: get your free key on Spotify's page and copy it. Then come back and press Paste key."
                    : root.soloist-step == 4 ? "Soloist is set up. Choose it above to use it."
                    : root.soloist-ready ? "Soloist is connected and ready."
                    : "Set up Soloist, step 3 of 3: in the Spotify app on this network, pick “Rustbeat” as the device, once. Allow it if Windows Firewall asks. If you did this before, it connects by itself.";
                color: Theme.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.soloist-step == 1: Pill { quiet: true; enabled: !root.downloading; text: root.downloading ? "Downloading…" : "Download"; clicked => { root.soloist-download(); } }
                if root.soloist-step == 1: Pill { quiet: true; text: "About Soloist"; clicked => { root.soloist-about(); } }
                if root.soloist-step == 2: Pill { quiet: true; text: "Get your key"; clicked => { root.soloist-get-key(); } }
                if root.soloist-step == 2: Pill { quiet: true; text: "Paste key"; clicked => { key.paste(); } }
                if root.soloist-step == 2 && root.new-key: Pill { quiet: true; text: "Keep the old key"; clicked => { root.new-key = false; } }
                if root.soloist-step == 3 && !root.soloist-ready: Pill { quiet: true; text: "Open Spotify"; clicked => { root.open-spotify(); } }
                if root.soloist-step > 2: Pill { quiet: true; text: "Change key"; clicked => { root.new-key = true; } }
                if root.soloist-step > 2: Pill { quiet: true; enabled: !root.downloading; text: root.downloading ? "Downloading…" : "Update Soloist"; clicked => { root.soloist-download(); } }
            }
            key := SecretBox { visible: root.soloist-step == 2; height: self.visible ? 36px : 0px; label: "Or paste it here and press Enter"; accepted(k) => { root.new-key = false; root.soloist-key(k); } }
            if root.player-note != "": Text { text: root.player-note; color: Theme.accent; wrap: word-wrap; }
        }
        Section {
            text: "Offline";
            Switch { text: "Offline mode"; note: "Plays only the files in your music folder, without Spotify"; checked: root.offline; toggled(on) => { root.set-offline(on); } }
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.music; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                VerticalLayout { alignment: center; Pill { quiet: true; text: "Choose folder"; clicked => { root.choose-music(); } } }
            }
            Text { text: "MP3, FLAC and Ogg Vorbis. Songs downloaded in the Spotify app are locked to it, so they can't be played here."; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
        }
        Section {
            text: "Equalizer";
            Switch { text: "Use the equalizer"; note: "Boosts turn the overall level down, so nothing clips"; checked: root.eq-on; toggled(on) => { root.set-eq-on(on); } }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for name[i] in root.presets: Pill { quiet: true; text: name; clicked => { root.set-preset(i); } }
            }
            HorizontalLayout {
                height: 210px;
                opacity: root.eq-on ? 1 : 0.5;
                for gain[i] in root.eq: EqBand { horizontal-stretch: 1; gain: gain; label: root.labels[i]; commit(v) => { root.set-band(i, v); } }
            }
        }
        Section {
            text: "Playback";
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Streaming quality"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                for rate in [96, 160, 320]: Pill { quiet: true; text: rate + " kbps"; selected: root.bitrate == rate; clicked => { root.set-bitrate(rate); } }
            }
            Switch { text: "Same volume for every song"; checked: root.normalise; toggled(on) => { root.set-normalise(on); } }
            if root.needs-restart: Text { text: "Quality, volume and Soloist's equalizer changes apply the next time Rustbeat starts."; color: Theme.accent; font-size: 12px; }
        }
        Section {
            text: "Window";
            Switch { text: "Keep playing when the window is closed"; note: "Rustbeat stays in the tray"; checked: root.tray; toggled(on) => { root.set-tray(on); } }
        }
        Section {
            text: "Listening together";
            Text { text: "Jam: open an invite link to join one here, or start one in the Spotify app with Rustbeat as the speaker. The Jam button in the player bar then shows who is in it, and its invite link."; color: Theme.dim; wrap: word-wrap; }
            Text { text: "Discord: Listen Along belongs to your Spotify account, so it follows what Rustbeat plays through Soloist. Connect Spotify to Discord once, and turn on “Display Spotify as your status”."; color: Theme.dim; wrap: word-wrap; }
            HorizontalLayout { alignment: start; Pill { quiet: true; text: "Open Discord's connections"; clicked => { root.discord(); } } }
        }
        Section {
            text: "Updates";
            Switch { text: "Look for new versions"; note: "Asks GitHub when Rustbeat starts"; checked: root.updates; toggled(on) => { root.set-updates(on); } }
            Text {
                text: root.version == "" ? "This copy was built from source, so it isn't updated by itself. Using a version below replaces it."
                    : root.version-chosen ? "Rustbeat " + root.version + ". It stays on the version you chose until you use the newest one."
                    : "Rustbeat " + root.version + ". New versions are installed when Rustbeat starts, and used from the next start.";
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.update-note != "": Text { text: root.update-note; color: Theme.accent; wrap: word-wrap; }
            if root.update-ready: HorizontalLayout { alignment: start; Pill { quiet: true; text: "Restart now"; clicked => { root.restart(); } } }
            // GitHub lists the newest first; the rest open below it.
            if root.versions.length > 0: VersionRow { v: root.versions[0]; updating: root.updating; use(tag) => { root.use-version(tag); } }
            if root.versions.length > 1: HorizontalLayout { alignment: start; Pill { quiet: true; text: root.older-open ? "Hide older versions" : "Show older versions"; clicked => { root.older-open = !root.older-open; } } }
            if root.older-open: VerticalLayout {
                spacing: 10px;
                for i in root.versions.length - 1: VersionRow { v: root.versions[i + 1]; updating: root.updating; use(tag) => { root.use-version(tag); } }
            }
        }
        Section {
            text: "Account";
            HorizontalLayout { alignment: start; Pill { quiet: true; text: "Sign out"; clicked => { root.logout(); } } }
        }
        Section {
            text: "About";
            Text { text: "Rustbeat is unofficial and not affiliated with or approved by Spotify. Free software under the MIT license."; color: Theme.dim; wrap: word-wrap; }
            HorizontalLayout {
                alignment: start;
                // Slint's credit is made for a dark background.
                Rectangle {
                    width: 280px;
                    height: 110px;
                    border-radius: 14px;
                    background: #17171d;
                    AboutSlint { width: 100%; height: 100%; }
                }
            }
        }
    }
}
