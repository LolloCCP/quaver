export global Theme {
    // Taken from the song's cover.
    in property <color> accent: #f2a65a;
    in property <color> fill: #f28c50;
    in property <color> fill2: #dc5a82;
    in property <color> ink: #14110f;
    in property <color> glass: #08080e;
    in property <color> text: #f9f6f2;
    in property <color> dim: #d2cbc4;

    in property <image> glow;
    in property <float> tint: 0.2;
    in property <bool> motion: true;
    // How many timed lyric lines show around the sung one; 0 for all.
    in property <int> lyric-lines;
    out property <duration> quick: root.motion ? 200ms : 0ms;
    // From the theme (art::Style): what makes things stand out on a surface, white or black.
    in property <color> over: white;
    in property <bool> bright;
    in property <float> gloss: 1;
    in property <bool> pointer-light: true;
    // art.rs tests text contrast on these.
    out property <color> selected: root.over.with-alpha(0.08);
    out property <float> light: 0.1;
    out property <color> raised: root.over.with-alpha(0.08);
    out property <color> line: root.over.with-alpha(0.18);
    out property <color> hover-line: root.over.with-alpha(0.42);
    out property <color> track: root.over.with-alpha(0.2);
    out property <string> icons: "Segoe Fluent Icons";
}

// The list songs are playing from, for the bars beside it.
export global Playing {
    in property <string> context;
    // Liked Songs is "liked" in the library but a collection URI when played.
    in property <bool> liked;
    in property <bool> playing;
    // Spotify forbids both for some lists, such as a Daily Mix.
    in property <bool> can-shuffle: true;
    in property <bool> can-repeat: true;
    public pure function from(uri: string) -> bool {
        return root.context != "" && (uri == root.context || (uri == "liked" && root.liked));
    }
}

// Three bars that dance while music plays, and stand still while it is paused.
export component Bars inherits Rectangle {
    property <bool> moving: Playing.playing && Theme.motion;
    // Only asks for frames while moving.
    property <float> t: root.moving ? animation-tick() / 1ms : 0;
    width: 13px;
    height: 13px;
    accessible-role: image;
    accessible-label: Playing.playing ? "Playing" : "Paused";
    for i in 3: Rectangle {
        property <float> wave: root.moving ? (1 + sin((root.t * (0.0062 + i * 0.0021) + i * 1.9) * 1rad)) / 2 : (i == 1 ? 0.85 : i == 0 ? 0.45 : 0.6);
        x: i * 5px;
        width: 3px;
        height: root.height * (0.25 + 0.75 * self.wave);
        y: root.height - self.height;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}

// The custom theme's colors: 0 is the background, 1 the highlight.
export global Custom {
    in property <color> base;
    in property <color> highlight;
    pure callback hex(color) -> string;
    callback picked(int, color);
    callback typed(int, string);
}

// The painted picture behind everything (art::Scene). Two layers cross-fade.
export global Scene {
    in property <image> a;
    in property <image> b;
    in property <bool> show-b;
    in property <duration> fade;
    in property <length> mouse-x;
    in property <length> mouse-y;
    in property <bool> hovering;
    // Where the panels are, so that they can be painted.
    callback placed(int, length, length, length, length);
}

export component Backdrop inherits Rectangle {
    // A layer that can't be seen isn't drawn.
    Image { visible: top.opacity < 1; source: Scene.a; width: 100%; height: 100%; image-fit: fill; }
    top := Image {
        visible: self.opacity > 0;
        source: Scene.b;
        width: 100%;
        height: 100%;
        image-fit: fill;
        opacity: Scene.show-b ? 1 : 0;
        animate opacity { duration: Scene.fade; easing: ease-in-out; }
    }
}

// A soft light under the pointer. Only for the inside of something clipped.
export component PointerLight inherits Rectangle {
    in property <length> size: 300px;
    in property <float> strength: Theme.light;
    in property <color> hue: Theme.accent;
    width: 100%;
    height: 100%;
    if Theme.pointer-light && Theme.motion && Scene.hovering: Image {
        x: Scene.mouse-x - root.absolute-position.x - root.size / 2;
        y: Scene.mouse-y - root.absolute-position.y - root.size / 2;
        width: root.size;
        height: root.size;
        source: Theme.glow;
        colorize: root.hue;
        opacity: root.strength;
    }
}

// A glass panel. With a `panel` number it is painted into the picture behind everything and
// costs nothing to draw; without one it is a plain pane that can fade.
export component Glass inherits Rectangle {
    in property <int> panel;
    property <bool> lit: Theme.pointer-light && Theme.motion && Scene.hovering && Scene.mouse-x >= root.absolute-position.x && Scene.mouse-x < root.absolute-position.x + root.width && Scene.mouse-y >= root.absolute-position.y && Scene.mouse-y < root.absolute-position.y + root.height;
    property <string> place: root.absolute-position.x / 1px + " " + root.absolute-position.y / 1px + " " + root.width / 1px + " " + root.height / 1px;
    function report() { if (root.panel > 0) { Scene.placed(root.panel, root.absolute-position.x, root.absolute-position.y, root.width, root.height); } }
    init => { root.report(); }
    changed place => { root.report(); }
    if root.panel == 0: Rectangle {
        border-radius: 24px;
        background: Theme.glass.with-alpha(Theme.bright ? 0.8 : 0.55);
        border-width: 1px;
        border-color: Theme.hover-line;
    }
    if root.lit: Rectangle {
        clip: true;
        border-radius: 24px;
        PointerLight { }
    }
    @children
}

// The wet highlight across the top of a filled shape.
component Shine inherits Rectangle {
    in property <float> strength: 0.5;
    background: @linear-gradient(180deg, white.with-alpha(root.strength * Theme.gloss) 0%, white.with-alpha(root.strength * 0.25 * Theme.gloss) 55%, #ffffff00 100%);
}

export component KeyFocus inherits FocusScope {
    callback activated();
    focus-on-click: false;
    key-pressed(e) => {
        if (e.text == " " || e.text == Key.Return) { root.activated(); return accept; }
        return reject;
    }
}

export component Icon inherits TouchArea {
    in property <string> glyph;
    in property <string> label;
    in property <bool> on;
    in property <length> size: 16px;
    width: 36px;
    height: 36px;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    disc := Rectangle {
        width: root.pressed ? 30px : root.has-hover ? 36px : 26px;
        height: self.width;
        border-radius: self.width / 2;
        background: @linear-gradient(180deg, Theme.over.with-alpha(0.22) 0%, Theme.over.with-alpha(0.08) 100%);
        border-width: 1px;
        border-color: Theme.line;
        opacity: root.has-hover && root.enabled ? 1 : 0;
        animate width, opacity { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    Rectangle { visible: focus.has-focus; border-radius: 18px; border-width: 2px; border-color: Theme.accent; }
    focus := KeyFocus { enabled: root.enabled; activated => { root.clicked(); } }
    Text {
        text: root.glyph;
        font-family: Theme.icons;
        font-size: root.pressed ? root.size - 2px : root.has-hover ? root.size + 2px : root.size;
        color: !root.enabled ? Theme.text.with-alpha(0.3) : root.on ? Theme.accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Pill inherits TouchArea {
    in property <string> text;
    in property <bool> quiet;
    in property <bool> selected;
    property <bool> filled: !root.quiet || root.selected;
    property <length> lift: root.pressed ? 1px : root.has-hover ? -2px : 0px;
    animate lift { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    width: label.preferred-width + (root.quiet ? 28px : 44px);
    height: root.quiet ? 34px : 46px;
    // A button that can't be used now looks it.
    opacity: root.enabled || root.selected ? 1 : 0.45;
    mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        y: root.lift;
        width: 100%;
        height: 100%;
        border-radius: root.height / 2;
        background: root.filled ? @linear-gradient(135deg, Theme.fill 0%, Theme.fill2 100%) : @linear-gradient(180deg, Theme.over.with-alpha(0.14) 0%, Theme.over.with-alpha(0.06) 100%);
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? Theme.text : root.has-hover ? Theme.hover-line : Theme.line;
        drop-shadow-blur: root.has-hover ? 14px : 0px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: root.filled ? Theme.fill.with-alpha(0.5) : Theme.bright ? transparent : #00000059;
        Shine { x: 6px; y: 1px; width: parent.width - 12px; height: parent.height * 0.45; border-radius: self.height; strength: root.filled ? 0.45 : 0.16; }
    }
    focus := KeyFocus { activated => { root.clicked(); } }
    label := Text { y: root.lift; height: 100%; text: root.text; font-weight: 600; color: root.filled ? Theme.ink : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
}

export component PlayButton inherits TouchArea {
    in property <bool> playing;
    in property <length> size: 44px;
    property <length> d: root.pressed ? root.size - 6px : root.has-hover ? root.size : root.size - 3px;
    animate d { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    width: root.size;
    height: root.size;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.playing ? "Pause" : "Play";
    accessible-action-default => { root.clicked(); }
    Rectangle {
        width: root.d;
        height: root.d;
        border-radius: root.d / 2;
        background: @linear-gradient(145deg, Theme.fill 0%, Theme.fill2 100%);
        border-width: focus.has-focus ? 3px : 1px;
        border-color: focus.has-focus ? Theme.text : #ffffff80;
        drop-shadow-blur: root.has-hover ? 22px : 14px;
        drop-shadow-color: Theme.fill.with-alpha(root.has-hover ? 0.7 : 0.4);
        Shine { x: root.d * 0.14; y: root.d * 0.03; width: root.d * 0.72; height: root.d * 0.46; border-radius: self.height / 2; strength: 0.6; }
    }
    focus := KeyFocus { activated => { root.clicked(); } }
    Text { text: root.playing ? "\u{e769}" : "\u{e768}"; font-family: Theme.icons; font-size: root.size * 0.42; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
}

export component Switch inherits TouchArea {
    in property <string> text;
    in property <string> note;
    in property <bool> checked;
    callback toggled(bool);
    height: root.note == "" ? 40px : 52px;
    mouse-cursor: pointer;
    clicked => { root.toggled(!root.checked); }
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => { root.toggled(!root.checked); }
    focus := KeyFocus { activated => { root.toggled(!root.checked); } }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.text; color: Theme.text; }
            if root.note != "": Text { text: root.note; color: Theme.dim; font-size: 12px; }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 46px;
                height: 26px;
                border-radius: 13px;
                background: root.checked ? @linear-gradient(90deg, Theme.fill 0%, Theme.fill2 100%) : Theme.track;
                border-width: focus.has-focus ? 2px : 1px;
                border-color: focus.has-focus ? Theme.text : Theme.line;
                Rectangle {
                    x: root.checked ? 23px : 3px;
                    y: 3px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: @linear-gradient(180deg, #ffffff 0%, #d8d8e0 100%);
                    animate x { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                }
            }
        }
    }
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <string> label;
    in property <bool> live;
    callback commit(float);
    property <float> dragged: max(0, min(1, touch.mouse-x / root.width));
    property <float> shown: touch.pressed ? root.dragged : root.value;
    height: 24px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-action-increment => { root.commit(min(1, root.value + 0.05)); }
    accessible-action-decrement => { root.commit(max(0, root.value - 0.05)); }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.modifiers.control) { return reject; }
            if (e.text == Key.LeftArrow) { root.commit(max(0, root.value - 0.05)); return accept; }
            if (e.text == Key.RightArrow) { root.commit(min(1, root.value + 0.05)); return accept; }
            return reject;
        }
    }
    property <bool> active: touch.has-hover || touch.pressed || focus.has-focus;
    property <length> thick: root.active ? 10px : 6px;
    property <length> knob: touch.pressed ? 20px : root.active ? 16px : 0px;
    animate thick, knob { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Rectangle { height: root.thick; border-radius: self.height / 2; background: Theme.track; }
    Rectangle {
        x: 0;
        width: root.width * root.shown;
        height: root.thick;
        border-radius: self.height / 2;
        background: @linear-gradient(90deg, Theme.fill2 0%, Theme.fill 100%);
        Shine { y: 0; height: parent.height / 2; border-radius: self.height; strength: 0.45; }
    }
    Rectangle {
        x: root.width * root.shown - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: @linear-gradient(180deg, #ffffff 0%, #d8d8e0 100%);
        border-width: 1px;
        border-color: #00000033;
    }
    touch := TouchArea {
        moved => { if (root.live) { root.commit(root.dragged); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) { root.commit(root.dragged); }
        }
    }
}

// One equalizer band, in dB.
export component EqBand inherits Rectangle {
    in property <float> gain;
    in property <string> label;
    callback commit(float);
    property <length> rail: root.height - 44px;
    property <float> at: 1 - (root.gain + 12) / 24;
    function pick(y: length) { root.commit(round((12 - max(0, min(1, (y - 22px) / root.rail)) * 24) * 2) / 2); }
    accessible-role: slider;
    accessible-label: root.label + " hertz";
    accessible-value: root.gain;
    accessible-value-minimum: -12;
    accessible-value-maximum: 12;
    accessible-action-increment => { root.commit(min(12, root.gain + 1)); }
    accessible-action-decrement => { root.commit(max(-12, root.gain - 1)); }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { root.commit(min(12, root.gain + 1)); return accept; }
            if (e.text == Key.DownArrow) { root.commit(max(-12, root.gain - 1)); return accept; }
            return reject;
        }
    }
    Text { y: 0; height: 18px; text: (root.gain > 0 ? "+" : "") + root.gain; font-size: 11px; color: root.gain == 0 ? Theme.dim : Theme.accent; horizontal-alignment: center; }
    Rectangle { y: 22px; width: 6px; height: root.rail; border-radius: 3px; background: Theme.track; }
    Rectangle {
        y: 22px + root.rail * min(0.5, root.at);
        width: 6px;
        height: root.rail * abs(root.at - 0.5);
        background: @linear-gradient(180deg, Theme.fill 0%, Theme.fill2 100%);
    }
    property <length> knob: touch.pressed ? 24px : touch.has-hover ? 21px : 18px;
    animate knob { duration: Theme.quick; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Rectangle {
        y: 22px + root.rail * root.at - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: @linear-gradient(180deg, #ffffff 0%, #d8d8e0 100%);
        border-width: focus.has-focus ? 3px : 1px;
        border-color: focus.has-focus ? Theme.accent : #00000033;
    }
    Text { y: root.height - 18px; height: 18px; text: root.label; font-size: 11px; color: Theme.dim; horizontal-alignment: center; }
    touch := TouchArea {
        moved => { root.pick(touch.mouse-y); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.pick(touch.mouse-y); }
        }
        double-clicked => { root.commit(0); }
    }
}

// Saturation to the right, brightness upwards, hue in the strip below.
export component ColorPicker inherits VerticalLayout {
    in property <string> label;
    in property <color> color;
    callback picked(color);
    callback typed(string);
    property <float> hue;
    property <float> sat;
    property <float> val;
    property <color> shown: hsv(root.hue, root.sat, root.val);
    function follow() {
        // A color's hue and saturation can't be told from gray or black, so a picked one is kept.
        if (root.shown != root.color) {
            root.hue = root.color.to-hsv().hue;
            root.sat = root.color.to-hsv().saturation;
            root.val = root.color.to-hsv().value;
        }
        if (!input.has-focus) { input.text = Custom.hex(root.color); }
    }
    function pick(h: float, s: float, v: float) {
        root.hue = max(0, min(359, h));
        root.sat = max(0, min(1, s));
        root.val = max(0, min(1, v));
        root.picked(root.shown);
    }
    spacing: 10px;
    preferred-width: 200px;
    init => { root.follow(); }
    changed color => { root.follow(); }
    Text { text: root.label; color: Theme.text; }
    square := Rectangle {
        height: 140px;
        accessible-role: slider;
        accessible-label: root.label + ", saturation and brightness";
        accessible-value: round(root.sat * 100) + ", " + round(root.val * 100);
        square-focus := FocusScope {
            focus-on-click: false;
            key-pressed(e) => {
                if (e.modifiers.control) { return reject; }
                if (e.text == Key.LeftArrow) { root.pick(root.hue, root.sat - 0.02, root.val); return accept; }
                if (e.text == Key.RightArrow) { root.pick(root.hue, root.sat + 0.02, root.val); return accept; }
                if (e.text == Key.UpArrow) { root.pick(root.hue, root.sat, root.val + 0.02); return accept; }
                if (e.text == Key.DownArrow) { root.pick(root.hue, root.sat, root.val - 0.02); return accept; }
                return reject;
            }
        }
        Rectangle { border-radius: 10px; background: hsv(root.hue, 1, 1); }
        Rectangle { border-radius: 10px; background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%); }
        Rectangle { border-radius: 10px; background: @linear-gradient(0deg, #000000 0%, #00000000 100%); }
        Rectangle { border-radius: 10px; border-width: square-focus.has-focus ? 2px : 1px; border-color: square-focus.has-focus ? Theme.accent : Theme.line; }
        Rectangle {
            x: root.sat * parent.width - 9px;
            y: (1 - root.val) * parent.height - 9px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: root.shown;
            border-width: 2px;
            border-color: white;
            Rectangle { x: -1px; y: -1px; width: 20px; height: 20px; border-radius: 10px; border-width: 1px; border-color: #00000080; }
        }
        square-touch := TouchArea {
            function at() { root.pick(root.hue, self.mouse-x / self.width, 1 - self.mouse-y / self.height); }
            moved => { self.at(); }
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.at(); } }
        }
    }
    strip := Rectangle {
        height: 18px;
        accessible-role: slider;
        accessible-label: root.label + ", hue";
        accessible-value: round(root.hue);
        accessible-value-minimum: 0;
        accessible-value-maximum: 359;
        accessible-action-increment => { root.pick(root.hue + 5, root.sat, root.val); }
        accessible-action-decrement => { root.pick(root.hue - 5, root.sat, root.val); }
        strip-focus := FocusScope {
            focus-on-click: false;
            key-pressed(e) => {
                if (e.modifiers.control) { return reject; }
                if (e.text == Key.LeftArrow) { root.pick(root.hue - 2, root.sat, root.val); return accept; }
                if (e.text == Key.RightArrow) { root.pick(root.hue + 2, root.sat, root.val); return accept; }
                return reject;
            }
        }
        Rectangle {
            border-radius: 9px;
            border-width: strip-focus.has-focus ? 2px : 1px;
            border-color: strip-focus.has-focus ? Theme.accent : Theme.line;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.7%, #00ff00 33.3%, #00ffff 50%, #0000ff 66.7%, #ff00ff 83.3%, #ff0000 100%);
        }
        Rectangle {
            x: root.hue / 359 * (parent.width - self.width);
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: hsv(root.hue, 1, 1);
            border-width: 2px;
            border-color: white;
            Rectangle { x: -1px; y: -1px; width: 20px; height: 20px; border-radius: 10px; border-width: 1px; border-color: #00000080; }
        }
        strip-touch := TouchArea {
            function at() { root.pick((self.mouse-x - 9px) / (self.width - 18px) * 359, root.sat, root.val); }
            moved => { self.at(); }
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.at(); } }
        }
    }
    Rectangle {
        height: 36px;
        border-radius: 18px;
        background: @linear-gradient(180deg, Theme.bright ? #0000000f : #00000040 0%, Theme.bright ? #00000008 : #ffffff1a 100%);
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.line;
        TouchArea { mouse-cursor: text; clicked => { input.focus(); } }
        Rectangle { x: 10px; width: 18px; height: 18px; border-radius: 9px; background: root.color; border-width: 1px; border-color: Theme.hover-line; }
        input := TextInput {
            x: 40px;
            width: root.width - 60px;
            height: 100%;
            single-line: true;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.ink;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-label: root.label + ", as a hex code";
            edited => { root.typed(self.text); }
            changed has-focus => { if (!self.has-focus) { self.text = Custom.hex(root.color); } }
        }
    }
}

export component Link inherits TouchArea {
    in property <string> text;
    in property <bool> linked;
    in property <color> color: Theme.dim;
    in property <color> hover: Theme.accent;
    in property <length> font-size: 14px;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <TextWrap> wrap: no-wrap;
    enabled: root.linked;
    mouse-cursor: root.linked ? MouseCursor.pointer : MouseCursor.default;
    accessible-role: button;
    accessible-enabled: root.linked;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text { width: 100%; height: 100%; text: root.text; font-size: root.font-size; wrap: root.wrap; overflow: elide; horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; color: root.linked && root.has-hover ? root.hover : root.color; }
}

export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> loaded;
    // The picture already has its rounded corners and gloss (art::jewel).
    if !root.loaded: Rectangle {
        border-radius: 14px;
        background: Theme.raised;
        Text { text: "\u{e8d6}"; font-family: Theme.icons; font-size: root.width / 3; color: Theme.dim; horizontal-alignment: center; vertical-alignment: center; }
    }
    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        opacity: root.loaded ? 1 : 0;
        animate opacity { duration: Theme.quick * 1.5; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    @children
}

export component Transport inherits HorizontalLayout {
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <length> size: 44px;
    callback toggle();
    callback next();
    callback prev();
    callback set-shuffle(bool);
    callback set-repeat(int);
    alignment: center;
    spacing: 10px;
    VerticalLayout { alignment: center; Icon { glyph: "\u{e8b1}"; enabled: Playing.can-shuffle; label: !Playing.can-shuffle ? "Spotify doesn't allow shuffle for this list" : root.shuffle ? "Turn shuffle off" : "Turn shuffle on"; on: root.shuffle; clicked => { root.set-shuffle(!root.shuffle); } } }
    VerticalLayout { alignment: center; Icon { glyph: "\u{e892}"; label: "Previous"; clicked => { root.prev(); } } }
    PlayButton { playing: root.playing; size: root.size; clicked => { root.toggle(); } }
    VerticalLayout { alignment: center; Icon { glyph: "\u{e893}"; label: "Next"; clicked => { root.next(); } } }
    VerticalLayout { alignment: center; Icon { glyph: root.repeat == 2 ? "\u{e8ed}" : "\u{e8ee}"; enabled: Playing.can-repeat; label: !Playing.can-repeat ? "Spotify doesn't allow repeat for this list" : root.repeat == 0 ? "Repeat all" : root.repeat == 1 ? "Repeat this song" : "Turn repeat off"; on: root.repeat != 0; clicked => { root.set-repeat(mod(root.repeat + 1, 3)); } } }
}

export component Timeline inherits HorizontalLayout {
    in property <float> progress;
    in property <string> elapsed;
    in property <string> total;
    callback seek(float);
    spacing: 10px;
    Text { text: root.elapsed; color: Theme.dim; font-size: 12px; width: 44px; horizontal-alignment: right; vertical-alignment: center; }
    Bar { horizontal-stretch: 1; value: root.progress; label: "Position"; commit(v) => { root.seek(v); } }
    Text { text: root.total; color: Theme.dim; font-size: 12px; width: 44px; vertical-alignment: center; }
}

export component SearchBox inherits Rectangle {
    in property <string> placeholder: "Search songs, artists and albums";
    in property <string> glyph: "\u{e721}";
    out property <string> value: input.text;
    callback accepted(string);
    callback edited(string);
    public function take-focus() { input.focus(); }
    public function set-text(text: string) { input.text = text; }
    height: 42px;
    border-radius: 21px;
    background: @linear-gradient(180deg, Theme.bright ? #0000000f : #00000040 0%, Theme.bright ? #00000008 : #ffffff1a 100%);
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : over.has-hover ? Theme.hover-line : Theme.line;
    over := TouchArea { mouse-cursor: text; clicked => { input.focus(); } }
    Text { x: 16px; width: 18px; text: root.glyph; font-family: Theme.icons; color: Theme.dim; vertical-alignment: center; }
    Text { x: 44px; visible: input.text == ""; text: root.placeholder; color: Theme.dim; vertical-alignment: center; }
    Rectangle {
        x: 44px;
        width: root.width - 64px;
        clip: true;
        input := TextInput {
            width: 100%;
            height: 100%;
            single-line: true;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.ink;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-label: root.placeholder;
            accepted => { if (self.text != "") { root.accepted(self.text); } }
            edited => { root.edited(self.text); }
        }
    }
}

// A one-line field for something that shouldn't be read over the shoulder.
export component SecretBox inherits Rectangle {
    in property <string> label;
    callback accepted(string);
    height: 36px;
    border-radius: 18px;
    background: @linear-gradient(180deg, Theme.bright ? #0000000f : #00000040 0%, Theme.bright ? #00000008 : #ffffff1a 100%);
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    TouchArea { mouse-cursor: text; clicked => { input.focus(); } }
    Text { x: 16px; visible: input.text == ""; text: root.label; color: Theme.dim; vertical-alignment: center; }
    Rectangle {
        x: 16px;
        width: root.width - 32px;
        clip: true;
        input := TextInput {
            width: 100%;
            height: 100%;
            single-line: true;
            input-type: password;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.ink;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-label: root.label;
            accepted => { root.save(); }
        }
    }
    public function paste() {
        input.select-all();
        input.paste();
        root.save();
    }
    public function save() {
        if (input.text != "") {
            root.accepted(input.text);
            input.text = "";
        }
    }
}
